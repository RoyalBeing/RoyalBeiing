<main class="section" style="min-height:100vh;display:grid;place-items:center">
  <div class="wrap center prose">
    <h1>{{ shop.name }}</h1>
    <p class="lead" style="margin-inline:auto">Coming soon — the ritual awaits.</p>
    {% form 'storefront_password' %}
      <div class="news-form" style="justify-content:center">
        <input type="password" name="password" placeholder="Enter store password" aria-label="Password">
        <button class="btn btn-primary" type="submit">Enter</button>
      </div>
      {%- if form.errors -%}<p class="form-status form-status--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {% endform %}
  </div>
</main>
