<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#355E4D">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'rb-main.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <!-- rb-theme:homepage-v3-forced -->
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip-link" href="#main">Skip to content</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main" role="main">
    {%- comment -%}
      Homepage sections are forced here so a stale Theme Editor index.json
      cannot hide the approved homepage stack. Other templates use JSON as usual.
    {%- endcomment -%}
    {%- if template.name == 'index' -%}
      {% section 'hero' %}
      {% section 'trust-bar' %}
      {% section 'collection-showcase' %}
      {% section 'video-feature' %}
      {% section 'ritual-bento' %}
      {% section 'featured-products' %}
      {% section 'product-spotlight' %}
      {% section 'subscriptions' %}
      {% section 'newsletter' %}
      {% section 'social-media' %}
      {% section 'faq-preview' %}
      {% section 'google-reviews' %}
      {% section 'cta-final' %}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}

  <script src="{{ 'rb-app.js' | asset_url }}" defer></script>
</body>
</html>
