{%- comment -%}
  Reads comment. Sets rb_public_stars, rb_public_body, and rb_public_media.
{%- endcomment -%}
{%- liquid
  assign rb_public_stars = 0
  if comment.content contains 'Rating: 5'
    assign rb_public_stars = 5
  elsif comment.content contains 'Rating: 4'
    assign rb_public_stars = 4
  elsif comment.content contains 'Rating: 3'
    assign rb_public_stars = 3
  elsif comment.content contains 'Rating: 2'
    assign rb_public_stars = 2
  elsif comment.content contains 'Rating: 1'
    assign rb_public_stars = 1
  endif
  assign rb_public_media = ''
  assign rb_public_body = ''
  assign rb_lines = comment.content | newline_to_br | split: '<br />'
  for line in rb_lines
    assign rb_bit = line | strip
    if rb_bit contains 'Media:'
      assign rb_public_media = rb_bit | split: 'Media:' | last | strip
    elsif rb_bit != blank
      unless rb_bit contains 'Product:' or rb_bit contains 'Rating:'
        if rb_public_body != blank
          assign rb_public_body = rb_public_body | append: ' '
        endif
        assign rb_public_body = rb_public_body | append: rb_bit
      endunless
    endif
  endfor
  assign rb_public_body = rb_public_body | strip
-%}
