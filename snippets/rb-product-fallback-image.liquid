{%- comment -%}
  Maps product handle → hosted product photo on the royal-being-images repo.
  Used when Shopify product media is missing so the storefront never looks empty.
  Expects: product (optional) or handle
{%- endcomment -%}
{%- liquid
  assign h = handle | default: product.handle
  assign cdn = 'https://raw.githubusercontent.com/asharqasmani-dotcom/royal-being-images/main/'
  assign file = ''

  case h
    when 'glow-rify'
      assign file = 'glow-rify__glow-rify-1.png'
    when 'the-rose-garden'
      assign file = 'the-rose-garden.jpg'
    when 'fresh-floral-fiesta'
      assign file = 'fresh-floral-fiesta__fresh-floral-fiesta-1.png'
    when 'the-enchanted-garden'
      assign file = 'the-enchanted-garden.jpg'
    when 'gilded-age'
      assign file = 'gilded-age__gilded-age-1.png'
    when 'the-reiny'
      assign file = 'the-reiny.jpg'
    when 'the-duchess'
      assign file = 'the-duchess.jpg'
    when 'african-rhapsody'
      assign file = 'african-rhapsody.jpg'
    when 'aquatic-escape'
      assign file = 'aquatic-escape__aquatic-escape-1.png'
    when 'herbal-galaxy-renewal'
      assign file = 'herbal-galaxy-renewal.jpg'
    when 'sweet-madagascar'
      assign file = 'sweet-madagascar.jpg'
    when 'melanin-popping'
      assign file = 'melanin-popping.jpg'
    when 'turmeric-swirl'
      assign file = 'turmeric-swirl__turmeric-swirl-1.png'
    when 'charcoal-moment'
      assign file = 'charcoal-moment__charcoal-moment-1.png'
    when 'islander'
      assign file = 'islander.jpg'
    when 'watermelon-fusion'
      assign file = 'watermelon-fusion.jpg'
    when 'zen-moment'
      assign file = 'zen-moment.jpg'
    when 'anti-aging-herbal'
      assign file = 'anti-aging-herbal.jpg'
    when 'aloe-vera-wave'
      assign file = 'aloe-vera-wave__aloe-vera-wave-1.png'
    when 'beef-tallow'
      assign file = 'beef-tallow__beef-tallow-1.png'
    when 'blissful-lavender'
      assign file = 'blissful-lavender__blissful-lavender-1.png'
    when 'detoxify'
      assign file = 'detoxify__detoxify-1.png'
    when 'citrus-heaven'
      assign file = 'citrus-heaven__citrus-heaven-1.png'
    when 'calm'
      assign file = 'calm__calm-1.png'
    when 'the-ethan'
      assign file = 'the-ethan__the-ethan-1.jpg'
    when 'the-aristocrat'
      assign file = 'the-aristocrat__the-aristocrat-1.jpg'
    when 'woody'
      assign file = 'woody__woody-1.jpg'
    when 'bamboozled'
      assign file = 'bamboozled__bamboozled-1.jpg'
    when 'teakwood'
      assign file = 'teakwood__teakwood-1.jpg'
    when 'the-chloe'
      assign file = 'the-chloe.jpg'
    when 'the-bodhi'
      assign file = 'the-bodhi.jpg'
    when 'the-matthew'
      assign file = 'the-matthew.jpg'
    when 'the-iris'
      assign file = 'the-iris.jpg'
  endcase
-%}
{%- if file != blank -%}{{ cdn }}{{ file }}{%- endif -%}
