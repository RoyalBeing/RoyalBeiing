{%- comment -%} Official product photo from theme assets, then catalog CDN fallback. {%- endcomment -%}
{%- liquid
  assign h = handle | default: product.handle
  if h == 'herbal-galaxy-renewal-soap'
    assign h = 'herbal-galaxy-renewal'
  elsif h == 'anti-aging-herbal-soap'
    assign h = 'anti-aging-herbal'
  elsif h == 'this-iris'
    assign h = 'the-iris'
  endif
  assign asset = 'rb-p-' | append: h | append: '.jpg'
-%}
{{ asset | asset_url }}
