{%- comment -%} Parse official catalog JSON packs. Wrap sources in {% raw %} so trailing }} is not Liquid. {%- endcomment -%}
{%- capture rb_shared_json -%}{% render 'rb-catalog-shared' %}{%- endcapture -%}
{%- assign rb_shared_json = rb_shared_json | strip -%}
{%- assign rb_catalog = rb_shared_json | parse_json -%}
{%- capture rb_json_royal -%}{% render 'rb-soaps-royal' %}{%- endcapture -%}
{%- assign rb_json_royal = rb_json_royal | strip -%}
{%- assign rb_pack_royal = rb_json_royal | parse_json -%}
{%- capture rb_json_signature -%}{% render 'rb-soaps-signature' %}{%- endcapture -%}
{%- assign rb_json_signature = rb_json_signature | strip -%}
{%- assign rb_pack_signature = rb_json_signature | parse_json -%}
{%- capture rb_json_common -%}{% render 'rb-soaps-common' %}{%- endcapture -%}
{%- assign rb_json_common = rb_json_common | strip -%}
{%- assign rb_pack_common = rb_json_common | parse_json -%}
{%- capture rb_json_duke -%}{% render 'rb-soaps-duke' %}{%- endcapture -%}
{%- assign rb_json_duke = rb_json_duke | strip -%}
{%- assign rb_pack_duke = rb_json_duke | parse_json -%}
{%- capture rb_json_kid -%}{% render 'rb-soaps-kid' %}{%- endcapture -%}
{%- assign rb_json_kid = rb_json_kid | strip -%}
{%- assign rb_pack_kid = rb_json_kid | parse_json -%}
