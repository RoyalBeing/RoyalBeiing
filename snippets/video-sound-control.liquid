<button
  type="button"
  class="rb-film__sound"
  data-video-sound
  aria-label="Unmute video"
  aria-pressed="true"
  title="Sound on"
>
  <span class="rb-film__sound-icon rb-film__sound-icon--off" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5 6 9H3v6h3l5 4V5z"/>
      <path d="m22 9-6 6M16 9l6 6"/>
    </svg>
  </span>
  <span class="rb-film__sound-icon rb-film__sound-icon--on" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5 6 9H3v6h3l5 4V5z"/>
      <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
      <path d="M18.5 6a8.5 8.5 0 0 1 0 12"/>
    </svg>
  </span>
  <span class="rb-film__sound-label">Sound on</span>
</button>
