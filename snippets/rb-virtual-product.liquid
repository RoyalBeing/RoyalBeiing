{%- comment -%} Full PDP for an official catalog soap that does not yet exist as a Shopify product. Pass rb_handle as a string. {%- endcomment -%}
{%- liquid
  assign v_title = blank
  assign v_price = blank
  case rb_handle
    when 'watermelon-fusion'
      assign v_title = 'Watermelon Fusion'
      assign v_price = '18.99'
    when 'herbal-galaxy-renewal'
      assign v_title = 'Herbal Galaxy Renewal Soap'
      assign v_price = '14'
    when 'sweet-madagascar'
      assign v_title = 'Sweet Madagascar'
      assign v_price = '21.99'
  endcase
  assign v_hero = 'rb-p-' | append: rb_handle | append: '.jpg'
  assign price_cents = v_price | times: 100 | round
-%}
{%- if v_title != blank -%}
<section class="section rb-virtual-pdp" data-virtual-product="{{ rb_handle | escape }}">
  <div class="wrap">
    <nav class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a> /
      <a href="/collections/signature">The Signature Collection</a> /
      {{ v_title }}
    </nav>

    <div class="pdp">
      <div class="pdp__gallery" data-pdp-gallery>
        <div class="pdp__stage">
          <button type="button" class="pdp__nav pdp__nav--prev" data-pdp-prev aria-label="Previous image">‹</button>
          <div class="pdp__main-img pdp__main-img--pop" id="pdp-main-img">
            <img
              data-pdp-stage
              src="{{ v_hero | asset_url }}"
              alt="{{ v_title | escape }}"
              width="1400"
              height="1400"
            >
          </div>
          <button type="button" class="pdp__nav pdp__nav--next" data-pdp-next aria-label="Next image">›</button>
        </div>
      </div>

      <div class="pdp__info">
        <div class="pdp__coll"><a href="/collections/signature">The Signature Collection</a></div>
        <h1>{{ v_title }}</h1>
        <span class="badge badge--mto" style="margin-bottom:10px;display:inline-block">Made to order</span>
        <div class="pdp__price">{{ price_cents | money }}</div>
        {%- render 'rb-soap-part', rb_handle: rb_handle, rb_part: 'glance' -%}

        {%- form 'contact', id: 'RoyalBeingSoapRequest', class: 'rb-virtual-order' -%}
          <input type="hidden" name="contact[subject]" value="Order request: {{ v_title | escape }}">
          <input type="hidden" name="contact[product]" value="{{ v_title | escape }}">
          <input type="hidden" name="contact[product_handle]" value="{{ rb_handle | escape }}">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">Thank you. Your request for {{ v_title }} was sent. We will confirm your made-to-order bar shortly.</p>
          {%- else -%}
            {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <p class="pdp__mto">This Signature bar is made to order in about 48 hours. Request it below and we will confirm your order at RoyalBeing@yahoo.com.</p>
            <div class="review-form__grid">
              <label class="form-field"><span>Name</span><input type="text" name="contact[name]" required autocomplete="name"></label>
              <label class="form-field"><span>Email</span><input type="email" name="contact[email]" required autocomplete="email"></label>
            </div>
            <label class="form-field"><span>Quantity</span>
              <input type="number" name="contact[quantity]" min="1" value="1" required>
            </label>
            <label class="form-field"><span>Notes</span>
              <textarea name="contact[body]" rows="3">Please make {{ v_title }} ({{ rb_handle }}) for me.</textarea>
            </label>
            <div class="pdp__actions">
              <button type="submit" class="btn btn-primary">Request this soap</button>
              <a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
            </div>
          {%- endif -%}
        {%- endform -%}

        <div class="pdp__meta">
          <span>Made to order · <b>~48 hours</b></span>
          <span>Handmade in small batches · Made in USA</span>
        </div>

        <div class="accordion">{%- render 'rb-soap-part', rb_handle: rb_handle, rb_part: 'acc' -%}</div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
