{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign h = product.handle
  if h == 'herbal-galaxy-renewal-soap'
    assign h = 'herbal-galaxy-renewal'
  elsif h == 'anti-aging-herbal-soap'
    assign h = 'anti-aging-herbal'
  elsif h == 'this-iris'
    assign h = 'the-iris'
  endif
  assign is_robe = false
  if product.type == 'Robe' or product.tags contains 'Robe' or h == 'terry-robe' or h == 'the-royal-being-terry-robe' or h == 'royal-being-terry-robe'
    assign is_robe = true
  endif
  assign soap_mto = false
  if is_robe == false
    if product.type == 'Herbal Soap' or product.tags contains 'Herbal Soap' or product.type == 'Soap'
      assign soap_mto = true
    endif
  endif
  assign sold_out = false
  if variant.available == false
    if is_robe or soap_mto == false
      assign sold_out = true
    endif
  endif
  assign card_title = product.title
  if rb_record != blank
    assign card_title = rb_record.title
  endif
  assign coming_soon = false
  if product.tags contains 'Coming Soon' and soap_mto == false
    assign coming_soon = true
  endif
  assign hero = 'rb-p-' | append: h | append: '.jpg'
  if rb_record != blank and rb_record.hero != blank
    assign hero = rb_record.hero
  endif
  assign card_coll = ''
  if rb_record != blank and rb_record.collection_title != blank
    assign card_coll = rb_record.collection_title
  endif
-%}
<article class="pcard pcard--pop" data-product-id="{{ product.id }}">
  <a class="pcard__media" href="{{ product.url }}" aria-label="{{ card_title | escape }}">
    <img
      src="{{ hero | asset_url }}"
      alt="{{ card_title | escape }}"
      loading="lazy"
      width="800"
      height="800"
    >
    <div class="pcard__badges">
      {%- if coming_soon -%}
        <span class="badge badge--soon">Coming Soon</span>
      {%- elsif sold_out -%}
        <span class="badge badge--soldout">Sold Out</span>
      {%- elsif soap_mto and variant.available == false -%}
        <span class="badge badge--mto">Made to order</span>
      {%- endif -%}
      {%- if product.tags contains 'Subscription Eligible' and sold_out == false -%}
        <span class="badge badge--sub">Subscribe</span>
      {%- endif -%}
    </div>
  </a>
  <div class="pcard__body">
    {%- if card_coll != blank -%}
      <div class="pcard__coll">{{ card_coll }}</div>
    {%- elsif product.collections.size > 0 -%}
      {%- for collection in product.collections -%}
        {%- if collection.handle != 'all' and collection.handle != 'frontpage' -%}
          <div class="pcard__coll">{{ collection.title }}</div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    <h3 class="pcard__name"><a href="{{ product.url }}">{{ card_title }}</a></h3>
    <div class="pcard__foot">
      <div class="pcard__price">
        {%- if rb_record != blank and rb_record.price != blank -%}
          {%- assign catalog_cents = rb_record.price | times: 100 | round -%}
          {{ catalog_cents | money }}
        {%- else -%}
          {{ variant.price | money }}
        {%- endif -%}
      </div>
      {%- if sold_out -%}
        <a class="btn btn-light btn-sm" href="{{ product.url }}">View</a>
      {%- else -%}
        <button
          type="button"
          class="btn btn-primary btn-sm"
          data-add-variant="{{ variant.id }}"
        >Add</button>
      {%- endif -%}
    </div>
  </div>
</article>
