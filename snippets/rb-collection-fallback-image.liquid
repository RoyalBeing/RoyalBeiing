{%- comment -%}
  Fallback collection cover from theme assets when collection.featured_image is blank.
  Expects: collection or handle
{%- endcomment -%}
{%- liquid
  assign h = handle | default: collection.handle
  assign asset = ''
  case h
    when 'royal', 'the-royal-collection'
      assign asset = 'rb-col-royal.jpg'
    when 'signature', 'the-signature-collection'
      assign asset = 'rb-col-signature.jpg'
    when 'common', 'the-common-collection'
      assign asset = 'rb-col-common.jpg'
    when 'royal-duke', 'the-royal-duke-collection'
      assign asset = 'rb-col-royal-duke.jpg'
    when 'royal-kid', 'the-royal-kid-herbal-collection', 'the-royal-kid-collection'
      assign asset = 'rb-col-royal-kid.png'
  endcase
-%}
{%- if asset != blank -%}{{ asset | asset_url }}{%- endif -%}
