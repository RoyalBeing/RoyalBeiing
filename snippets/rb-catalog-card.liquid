{%- comment -%} Product card for an official catalog soap that is not yet a Shopify product. {%- endcomment -%}
{%- assign rec = rb_record -%}
{%- if rec == blank and rb_handle != blank -%}
  {%- assign rec = rb_catalog.products[rb_handle] -%}
{%- endif -%}
{%- if rec != blank -%}
  {%- assign price_cents = rec.price | times: 100 | round -%}
  {%- assign hero = rec.hero | default: rec.gallery.first | default: 'rb-life-stack.jpg' -%}
{%- if card_style == 'carousel' -%}
<article class="pcar-card" data-catalog-handle="{{ rec.handle | escape }}" data-mood="citrus">
  <a class="pcar-card__media" href="/products/{{ rec.handle }}" aria-label="{{ rec.title | escape }}">
    <span class="pcar-card__stage" aria-hidden="true"></span>
    <span class="pcar-card__atm" aria-hidden="true"></span>
    <img class="pcar-card__soap" src="{{ hero | asset_url }}" alt="{{ rec.title | escape }}" loading="lazy" width="900" height="900">
  </a>
  <div class="pcar-card__body">
    <span class="pcar-card__coll">{{ rec.collection_title }}</span>
    <a class="pcar-card__name" href="/products/{{ rec.handle }}">{{ rec.title }}</a>
    <span class="pcar-card__price">{{ price_cents | money }}</span>
    <div class="pcar-card__actions">
      <a class="pcar-card__ritual" href="/products/{{ rec.handle }}">View ritual<span aria-hidden="true"> →</span></a>
    </div>
  </div>
</article>
{%- else -%}
<article class="pcard pcard--pop" data-catalog-handle="{{ rec.handle | escape }}">
  <a class="pcard__media" href="/products/{{ rec.handle }}" aria-label="{{ rec.title | escape }}">
    <img src="{{ hero | asset_url }}" alt="{{ rec.title | escape }}" loading="lazy" width="800" height="800">
    <div class="pcard__badges">
      <span class="badge badge--mto">Made to order</span>
    </div>
  </a>
  <div class="pcard__body">
    {%- if rec.collection_title != blank -%}
      <div class="pcard__coll">{{ rec.collection_title }}</div>
    {%- endif -%}
    <h3 class="pcard__name"><a href="/products/{{ rec.handle }}">{{ rec.title }}</a></h3>
    <div class="pcard__foot">
      <div class="pcard__price">{{ price_cents | money }}</div>
      <a class="btn btn-primary btn-sm" href="/products/{{ rec.handle }}">View</a>
    </div>
  </div>
</article>
{%- endif -%}
{%- endif -%}
