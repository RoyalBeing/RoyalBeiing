<section class="section section--compact rb-film rb-film--spotlight" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="rb-film__grid reveal">
      <div class="rb-film__media">
        {%- liquid
          assign product = section.settings.product
          assign poster = section.settings.poster
          assign video = section.settings.video
          assign video_url = section.settings.video_url
        -%}
        {%- if video != blank -%}
          <div class="rb-film__player" data-hover-video>
            {{ video | video_tag: image_size: '1200x', controls: false, muted: true, autoplay: false, loop: true, class: 'rb-video', playsinline: true }}
            <span class="rb-film__hint" aria-hidden="true">Hover to play</span>
          </div>
        {%- elsif video_url != blank -%}
          <div class="rb-film__player" data-hover-video>
            <video
              class="rb-video"
              muted
              loop
              playsinline
              preload="metadata"
              {% if poster != blank %}poster="{{ poster | image_url: width: 1400 }}"{% elsif product != blank and product.featured_media %}poster="{{ product.featured_media | image_url: width: 1400 }}"{% else %}poster="{{ 'rb-story.jpg' | asset_url }}"{% endif %}
              aria-label="{{ section.settings.heading | escape }}"
            >
              <source src="{{ video_url }}" type="video/mp4">
            </video>
            <span class="rb-film__hint" aria-hidden="true">Hover to play</span>
          </div>
        {%- elsif section.settings.image != blank -%}
          <div class="rb-film__player">
            <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy" width="1400" height="788">
          </div>
        {%- elsif product != blank and product.featured_media -%}
          <div class="rb-film__player">
            <img src="{{ product.featured_media | image_url: width: 1400 }}" alt="{{ product.title | escape }}" loading="lazy" width="1400" height="788">
          </div>
        {%- else -%}
          <div class="rb-film__player rb-film__player--empty">
            <p class="note">Add the Watermelon Fusion film URL in Theme settings.</p>
          </div>
        {%- endif -%}
      </div>

      <div class="rb-film__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="serif-accent rb-film__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rb-film__text lead">{{ section.settings.text | newline_to_br }}</div>
        {%- endif -%}
        {%- if section.settings.closing != blank -%}
          <p class="serif-accent rb-film__closing">{{ section.settings.closing }}</p>
        {%- endif -%}

        {%- if product != blank -%}
          <div class="pdp__meta rb-film__meta">
            {%- if section.settings.meta_natural != blank -%}<span><b>{{ section.settings.meta_natural }}</b></span>{%- endif -%}
            {%- if section.settings.meta_weight != blank -%}<span>Weight: <b>{{ section.settings.meta_weight }}</b></span>{%- endif -%}
            <span>Price: <b>{{ product.price | money }}</b></span>
            {%- if section.settings.meta_sku != blank -%}
              <span>SKU: <b>{{ section.settings.meta_sku }}</b></span>
            {%- elsif product.selected_or_first_available_variant.sku != blank -%}
              <span>SKU: <b>{{ product.selected_or_first_available_variant.sku }}</b></span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-primary" href="{% if product != blank %}{{ product.url }}{% else %}{{ section.settings.button_link }}{% endif %}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
    { "type": "image_picker", "id": "poster", "label": "Video poster" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "Or MP4 URL", "default": "https://cdn.shopify.com/videos/c/o/v/4ea7ed019d114331a66343175f778527.mp4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A SIGNATURE ESCAPE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watermelon Fusion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The Ritual of Being" },
    { "type": "textarea", "id": "text", "label": "Main text", "default": "Elevate your skincare cleansing routine with Watermelon Fusion. This luxurious herbal bar combines nourishing goat’s milk, refreshing watermelon, cooling peppermint, and gentle poppy-seed exfoliation.\n\nIts creamy lather gently cleanses and polishes while leaving the skin feeling smoother, softer, refreshed, and renewed. With every use, its bright tropical aroma transforms an everyday routine into a joyful sensory escape." },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Elevate your daily cleansing into a sacred spa ritual." },
    { "type": "text", "id": "meta_natural", "label": "Natural line", "default": "100% Natural & Handmade" },
    { "type": "text", "id": "meta_weight", "label": "Weight", "default": "6.7 oz" },
    { "type": "text", "id": "meta_sku", "label": "SKU override", "default": "WM-ORG-BR-04-ST" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "SHOP WATERMELON FUSION" },
    { "type": "url", "id": "button_link", "label": "Primary link (if no product)" }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
