{%- comment -%}
  Homepage watermelon film. Landscape cut only (assets/rb-watermelon-fusion.mp4).
  The CDN file in settings is the vertical version and must not render here.
{%- endcomment -%}
<section class="rb-film rb-film--spotlight" {{ section.shopify_attributes }}>
  {%- liquid
    assign poster = section.settings.poster
    assign video_url = 'rb-watermelon-fusion.mp4' | asset_url
  -%}
  <div class="rb-film__player is-muted" data-autoplay-video>
    <video
      class="rb-video"
      muted
      loop
      autoplay
      playsinline
      webkit-playsinline
      preload="auto"
      {% if poster != blank %}poster="{{ poster | image_url: width: 2000 }}"{% endif %}
      aria-label="Watermelon Fusion"
    >
      <source src="{{ video_url }}" type="video/mp4">
    </video>
    {% render 'video-sound-control' %}
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A signature escape" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watermelon Fusion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The Ritual of Being" },
    { "type": "textarea", "id": "text", "label": "Description" },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Elevate your daily cleansing into a sacred spa ritual." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Watermelon Fusion" },
    { "type": "video", "id": "video", "label": "Video (Shopify file)" },
    { "type": "text", "id": "video_url", "label": "Video URL", "info": "Unused. This section always plays the landscape theme film." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "image_picker", "id": "image", "label": "Still image" }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
