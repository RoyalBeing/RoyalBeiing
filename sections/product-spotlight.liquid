<section class="section split{% if section.settings.reverse %} split--rev{% endif %} product-spotlight" {{ section.shopify_attributes }}>
  <div class="split__media reveal">
    {%- liquid
      assign product = section.settings.product
      assign video = section.settings.video
      assign video_url = section.settings.video_url
    -%}
    {%- if video != blank -%}
      {{ video | video_tag: image_size: '1000x', controls: true, autoplay: false, muted: false, loop: false, class: 'rb-video' }}
    {%- elsif video_url != blank -%}
      <video class="rb-video" controls playsinline preload="none"
        {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% elsif product.featured_media %}poster="{{ product.featured_media | image_url: width: 1200 }}"{% else %}poster="{{ 'rb-story.jpg' | asset_url }}"{% endif %}
        aria-label="{{ section.settings.heading | escape }} video">
        <source src="{{ video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
    {%- elsif product != blank and product.featured_media -%}
      <img src="{{ product.featured_media | image_url: width: 1400 }}" alt="{{ product.title | escape }}" loading="lazy">
    {%- else -%}
      <img src="{{ 'rb-story.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
  </div>

  <div class="reveal" style="padding-inline:var(--pad-x)">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="serif-accent" style="font-size:1.35rem;margin:8px 0 16px;color:var(--rb-green-900)">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="lead" style="margin-bottom:14px">{{ section.settings.text | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.closing != blank -%}<p class="serif-accent" style="font-size:1.2rem;margin-bottom:18px">{{ section.settings.closing }}</p>{%- endif -%}

    {%- if product != blank -%}
      <div class="pdp__meta" style="margin-top:0">
        {%- if section.settings.meta_natural != blank -%}<span><b>{{ section.settings.meta_natural }}</b></span>{%- endif -%}
        {%- if section.settings.meta_weight != blank -%}<span>Weight: <b>{{ section.settings.meta_weight }}</b></span>{%- endif -%}
        <span>Price: <b>{{ product.price | money }}</b></span>
        {%- if section.settings.meta_sku != blank -%}<span>SKU: <b>{{ section.settings.meta_sku }}</b></span>{%- elsif product.selected_or_first_available_variant.sku != blank -%}<span>SKU: <b>{{ product.selected_or_first_available_variant.sku }}</b></span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="hero__cta" style="margin-top:22px">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-primary" href="{% if product != blank %}{{ product.url }}{% else %}{{ section.settings.button_link }}{% endif %}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        {%- if section.settings.video != blank or section.settings.video_url != blank -%}
          <a class="btn btn-outline" href="{{ section.settings.button2_link | default: '#watermelon-film' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_film_below -%}
  {%- if section.settings.video != blank or section.settings.video_url != blank -%}
  <section class="section" id="watermelon-film" style="padding-top:0">
    <div class="wrap">
      <div class="filmstrip" style="aspect-ratio:16/9">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1200x', controls: true, autoplay: false, class: 'rb-video' }}
        {%- else -%}
          <video class="rb-video" controls playsinline preload="none" aria-label="Watermelon Fusion film">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
    { "type": "image_picker", "id": "poster", "label": "Video poster" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "Or MP4 URL" },
    { "type": "checkbox", "id": "show_film_below", "label": "Also show full-width film below", "default": false },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A SIGNATURE ESCAPE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watermelon Fusion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The Ritual of Being" },
    { "type": "textarea", "id": "text", "label": "Main text", "default": "Elevate your skincare cleansing routine with Watermelon Fusion. This luxurious herbal bar combines nourishing goat’s milk, refreshing watermelon, cooling peppermint, and gentle poppy-seed exfoliation.\n\nIts creamy lather gently cleanses and polishes while leaving the skin feeling smoother, softer, refreshed, and renewed. With every use, its bright tropical aroma transforms an everyday routine into a joyful sensory escape." },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Elevate your daily cleansing into a sacred spa ritual." },
    { "type": "text", "id": "meta_natural", "label": "Natural line", "default": "100% Natural & Handmade" },
    { "type": "text", "id": "meta_weight", "label": "Weight", "default": "6.7 oz" },
    { "type": "text", "id": "meta_sku", "label": "SKU override", "default": "WM-ORG-BR-04-ST" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "SHOP WATERMELON FUSION" },
    { "type": "url", "id": "button_link", "label": "Primary link (if no product)" },
    { "type": "text", "id": "button2_label", "label": "Secondary button (shown only when video is set)", "default": "" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
