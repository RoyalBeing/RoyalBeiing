{%- include 'rb-product-record' -%}
{%- liquid
  assign rb_handle = product.handle
  if rb_handle == 'herbal-galaxy-renewal-soap'
    assign rb_handle = 'herbal-galaxy-renewal'
  elsif rb_handle == 'anti-aging-herbal-soap'
    assign rb_handle = 'anti-aging-herbal'
  elsif rb_handle == 'this-iris'
    assign rb_handle = 'the-iris'
  endif
-%}
{%- capture rb_one_json -%}{% render 'rb-soap-json', rb_handle: rb_handle %}{%- endcapture -%}
{%- assign rb_one_json = rb_one_json | strip -%}
{%- if rb_one_json != blank -%}
  {%- assign rb_one = rb_one_json | parse_json -%}
  {%- if rb_one != blank -%}
    {%- assign rb_record = rb_one -%}
    {%- unless rb_is_robe -%}
      {%- assign rb_is_soap = true -%}
    {%- endunless -%}
  {%- endif -%}
{%- endif -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- liquid
  assign soap_mto = false
  if rb_is_soap
    assign soap_mto = true
  endif
  assign can_buy = false
  if current.available or soap_mto
    assign can_buy = true
  endif
  if rb_is_robe and current.available == false
    assign can_buy = false
  endif
-%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap">
    <nav class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a> /
      {%- if rb_record != blank -%}
        <a href="/collections/{{ rb_record.collection | replace: 'duke', 'royal-duke' | replace: 'kid', 'royal-kid' }}">{{ rb_record.collection_title }}</a> /
      {%- elsif product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> /
      {%- endif -%}
      {{ product.title }}
    </nav>

    <div class="pdp">
      <div class="pdp__gallery" data-pdp-gallery>
        {%- assign slides = '' -%}
        <div class="pdp__stage">
          <button type="button" class="pdp__nav pdp__nav--prev" data-pdp-prev aria-label="Previous image">‹</button>
          <div class="pdp__main-img pdp__main-img--pop" id="pdp-main-img">
            {%- if product.featured_media -%}
              {%- if product.featured_media.media_type == 'video' or product.featured_media.media_type == 'external_video' -%}
                {{ product.featured_media | video_tag: image_size: '1400x', controls: true, muted: false, autoplay: false, loop: false, playsinline: true }}
              {%- else -%}
                <img data-pdp-stage src="{{ product.featured_media | image_url: width: 1400 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="1400" height="1400">
              {%- endif -%}
            {%- elsif rb_record != blank and rb_record.hero != blank -%}
              <img
                data-pdp-stage
                src="{{ rb_record.hero | asset_url }}"
                alt="{{ product.title | escape }}"
                width="1400"
                height="1400"
              >
            {%- else -%}
              {%- capture rb_img -%}{% render 'rb-product-fallback-image', product: product %}{%- endcapture -%}
              <img data-pdp-stage src="{{ rb_img | strip }}" alt="{{ product.title | escape }}" width="1400" height="1400">
            {%- endif -%}
          </div>
          <button type="button" class="pdp__nav pdp__nav--next" data-pdp-next aria-label="Next image">›</button>
        </div>

        <div class="pdp__thumbs" data-pdp-thumbs>
          {%- assign thumb_i = 0 -%}
          {%- if product.media.size > 1 -%}
            {%- for m in product.media -%}
              <button
                type="button"
                class="{% if forloop.first %}active{% endif %}"
                data-kind="{% if m.media_type == 'video' or m.media_type == 'external_video' %}video{% else %}image{% endif %}"
                data-src="{% if m.media_type == 'video' %}{{ m.sources.last.url }}{% else %}{{ m | image_url: width: 1400 }}{% endif %}"
                data-alt="{{ m.alt | default: product.title | escape }}"
              >
                <img src="{{ m | image_url: width: 200 }}" alt="{{ product.title | escape }} view {{ forloop.index }}" width="200" height="200" loading="lazy">
              </button>
            {%- endfor -%}
          {%- elsif rb_record != blank -%}
            {%- for asset_name in rb_record.gallery -%}
              {%- assign thumb_i = thumb_i | plus: 1 -%}
              <button
                type="button"
                class="{% if thumb_i == 1 %}active{% endif %}"
                data-kind="image"
                data-src="{{ asset_name | asset_url }}"
                data-alt="{{ product.title | escape }}"
              >
                <img src="{{ asset_name | asset_url }}" alt="{{ product.title | escape }} view {{ thumb_i }}" width="200" height="200" loading="lazy">
              </button>
            {%- endfor -%}
            {%- if rb_record.video != blank -%}
              <button
                type="button"
                class="pdp__thumbs--video"
                data-kind="video"
                data-src="{{ rb_record.video }}"
                data-alt="{{ product.title | escape }} film"
                data-poster="{% if rb_record.hero != blank %}{{ rb_record.hero | asset_url }}{% endif %}"
              >
                <span class="pdp__play">▶</span>
                <img src="{{ rb_record.hero | asset_url }}" alt="{{ product.title | escape }} video" width="200" height="200" loading="lazy">
              </button>
            {%- endif -%}
            {%- if rb_record.matrix != blank -%}
              <button
                type="button"
                data-kind="image"
                data-src="{{ rb_record.matrix | asset_url }}"
                data-alt="{{ rb_record.collection_title | escape }} skin type matrix"
              >
                <img src="{{ rb_record.matrix | asset_url }}" alt="{{ rb_record.collection_title | escape }} matrix" width="200" height="200" loading="lazy">
              </button>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <div class="pdp__info">
        {%- if rb_record != blank -%}
          <div class="pdp__coll"><a href="/collections/{% if rb_record.collection == 'duke' %}royal-duke{% elsif rb_record.collection == 'kid' %}royal-kid{% else %}{{ rb_record.collection }}{% endif %}">{{ rb_record.collection_title }}</a></div>
        {%- elsif product.collections.first -%}
          <div class="pdp__coll"><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a></div>
        {%- endif -%}
        <h1>{{ product.title }}</h1>
        {%- if rb_is_robe and current.available == false -%}
          <span class="badge badge--soldout" style="margin-bottom:10px;display:inline-block">Sold Out</span>
        {%- elsif product.tags contains 'Coming Soon' and soap_mto == false -%}
          <span class="badge badge--soon" style="margin-bottom:10px;display:inline-block">Coming Soon</span>
        {%- endif -%}
        <div class="pdp__price">
          {% render 'price', product: product %}
        </div>

        {%- if rb_record != blank and rb_record.first_glance != blank -%}
          <p class="lead pdp__glance">{{ rb_record.first_glance }}</p>
        {%- elsif rb_is_robe -%}
          <p class="lead pdp__glance">{{ rb_catalog.robe.intro }}</p>
        {%- endif -%}

        {%- form 'product', product, id: 'product-form' -%}
          <input type="hidden" name="id" value="{{ current.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="buy-opts" style="margin-bottom:16px">
              {%- for option in product.options_with_values -%}
                <div class="form-field">
                  <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if product.selling_plan_groups.size > 0 -%}
            <div class="rb-selling-plans" data-selling-plans>
              <p class="rb-selling-plans__label">Purchase options</p>
              <label class="rb-selling-plans__option">
                <input type="radio" name="purchase_option" value="one-time" checked data-selling-plan-clear>
                <span>
                  <strong>One-time purchase</strong>
                  <em>{{ current.price | money }}</em>
                </span>
              </label>
              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- liquid
                    assign alloc = blank
                    for allocation in current.selling_plan_allocations
                      if allocation.selling_plan.id == plan.id
                        assign alloc = allocation
                      endif
                    endfor
                    assign plan_price = current.price
                    if alloc != blank
                      assign plan_price = alloc.price
                    endif
                    assign adj = plan.price_adjustments.first
                    assign plan_note = ''
                    if adj != blank and adj.value_type == 'percentage'
                      assign plan_note = adj.value | append: '% off'
                    endif
                  -%}
                  <label class="rb-selling-plans__option">
                    <input type="radio" name="purchase_option" value="{{ plan.id }}" data-selling-plan-id="{{ plan.id }}">
                    <span>
                      <strong>{{ plan.name }}</strong>
                      {%- if plan_note != blank -%}<small>{{ plan_note }}</small>{%- endif -%}
                      <em>{{ plan_price | money }}</em>
                    </span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}
              <input type="hidden" name="selling_plan" value="" data-selling-plan-input>
            </div>
          {%- endif -%}

          {%- if can_buy -%}
            {%- if soap_mto and current.available == false -%}
              <p class="pdp__mto">Made to order — soaps are crafted within approximately 48 hours. Add to Cart remains available.</p>
            {%- endif -%}
            <div class="pdp__actions">
              <div class="qty">
                <button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
                <span id="pdp-qty">1</span>
                <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
              </div>
              <button type="button" class="btn btn-primary" data-add-variant="{{ current.id }}">{{ section.settings.add_label }}</button>
              {{ form | payment_button }}
            </div>
          {%- else -%}
            <div class="status-note"><b>Currently unavailable.</b> Check back soon or browse other items in this collection.</div>
            <a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
          {%- endif -%}
        {%- endform -%}

        <div class="pdp__meta">
          {%- if soap_mto -%}<span>Made to order · <b>~48 hours</b></span>{%- endif -%}
          <span>{{ section.settings.ships_note }}</span>
        </div>

        {%- if rb_record != blank and rb_is_robe == false -%}
          {%- liquid
            assign rb_care_copy = rb_catalog.care.soap
            if rb_care_copy == blank
              assign rb_care_copy = 'Keep your bar dry between uses on a well-draining soap dish, away from direct streams of water.'
            endif
            assign rb_ship_copy = 'Soaps are made to order within approximately 48 hours. Standard retail orders are then hand-packed and shipped within 2-4 business days, excluding major holidays. Shipping timelines provided at checkout are estimates from third-party carriers and are not guaranteed. Royal Being currently ships to the United States, the Netherlands, and Belgium. Risk of loss and title for all merchandise pass to you upon our delivery to the shipping carrier. We are not liable for delayed, lost, stolen, or mis-delivered packages.'
          -%}
          <div class="accordion">
            <div class="acc open">
              <button type="button" aria-expanded="true">Description<span class="plus">+</span></button>
              <div class="acc__body rte">
                <h3>The Science and Targeted Therapeutic Benefits</h3>
                <p>{{ rb_record.science }}</p>
                {%- if rb_record.benefits.size > 0 -%}
                  <h3>Key Skin Benefits</h3>
                  <ul>
                    {%- for b in rb_record.benefits -%}
                      <li>{{ b }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if rb_record.collection == 'kid' and rb_record.ideal_for != blank -%}
                  <p><strong>Best For:</strong> {{ rb_record.ideal_for }}</p>
                {%- elsif rb_record.profile != blank -%}
                  <p><strong>The Profile:</strong> {{ rb_record.profile }}</p>
                {%- elsif rb_record.ideal_for != blank -%}
                  <p><strong>Ideal For:</strong> {{ rb_record.ideal_for }}</p>
                {%- endif -%}
              </div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Ingredients<span class="plus">+</span></button>
              <div class="acc__body rte"><p>{{ rb_record.ingredients }}</p></div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">The Ritual<span class="plus">+</span></button>
              <div class="acc__body rte"><p>{{ rb_record.ritual }}</p></div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Care<span class="plus">+</span></button>
              <div class="acc__body rte"><p>{{ rb_care_copy }}</p></div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Storage / Safety Disclaimer<span class="plus">+</span></button>
              <div class="acc__body rte">
                {%- if rb_record.safety != blank -%}
                  <p><strong>Safety Disclaimer:</strong> {{ rb_record.safety }}</p>
                {%- else -%}
                  <p><strong>Safety Disclaimer:</strong> {{ section.settings.caution }}</p>
                {%- endif -%}
                {%- if rb_record.aromatherapy != blank -%}
                  <p><strong>Aromatherapy &amp; Herbal Note:</strong> {{ rb_record.aromatherapy }}</p>
                {%- endif -%}
              </div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Shipping<span class="plus">+</span></button>
              <div class="acc__body rte"><p>{{ rb_ship_copy }}</p></div>
            </div>
          </div>
        {%- else -%}
          <div class="accordion">
            <div class="acc open">
              <button type="button" aria-expanded="true">Description<span class="plus">+</span></button>
              <div class="acc__body rte">
                {%- if rb_is_robe -%}
                  <p>{{ rb_catalog.robe.description }}</p>
                  <h3>The Standout Features</h3>
                  <ul>
                    {%- for feat in rb_catalog.robe.features -%}
                      <li>{{ feat }}</li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
              </div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Care &amp; Storage / Safety Disclaimer<span class="plus">+</span></button>
              <div class="acc__body rte">
                <p><strong>Safety Disclaimer:</strong> {{ section.settings.caution }}</p>
              </div>
            </div>
            <div class="acc">
              <button type="button" aria-expanded="false">Shipping<span class="plus">+</span></button>
              <div class="acc__body rte"><p>{{ rb_catalog.shipping.body }}</p></div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section class="section rb-pdp-reviews" id="product-reviews">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Community</p>
      <h2>Reviews for {{ product.title }}</h2>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="grev__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}
    {%- form 'contact', id: 'RoyalBeingProductReview', class: 'review-form card-soft' -%}
      <input type="hidden" name="contact[subject]" value="Review: {{ product.title | escape }}">
      <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">Thank you. Your review of {{ product.title }} was sent.</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="review-form__grid">
          <label class="form-field"><span>Name</span><input type="text" name="contact[name]" required autocomplete="name"></label>
          <label class="form-field"><span>Email</span><input type="email" name="contact[email]" required autocomplete="email"></label>
        </div>
        <label class="form-field"><span>Your review</span><textarea name="contact[body]" rows="4" required></textarea></label>
        <p class="note">Photo and video reviews display through the review app block above when a media-capable review app is installed on this store.</p>
        <button type="submit" class="btn btn-primary">Submit review</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{%- if section.settings.show_related -%}
  {%- assign related = product.collections.first -%}
  {%- if related -%}
    <section class="section" style="background:var(--rb-mist)">
      <div class="wrap">
        <div class="sec-head reveal"><p class="eyebrow">Other Items You May Like</p><h2>More from {{ related.title }}</h2></div>
        <div class="product-grid reveal">
          {%- assign shown = 0 -%}
          {%- for p in related.products -%}
            {%- if p.id != product.id and shown < 4 -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- if can_buy -%}
  <div class="buy-bar">
    <div><div style="font-family:var(--font-display);font-size:1.1rem">{{ product.title }}</div></div>
    <div class="bb-price">{{ current.price | money }}</div>
    <button type="button" class="btn btn-primary btn-sm" data-add-variant="{{ current.id }}">{{ section.settings.add_label }}</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "ships_note", "label": "Shipping note", "default": "Handmade in small batches · Made in USA" },
    { "type": "textarea", "id": "caution", "label": "Fallback safety disclaimer", "default": "For external use only. Avoid direct contact with eyes. In case of contact, rinse thoroughly with water. Discontinue use immediately if irritation, redness, or rash occurs. Consult a healthcare professional if irritation persists. Keep out of reach of children." },
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
