<section class="section rb-social" {{ section.shopify_attributes }}>
  <div class="wrap center">
    <div class="sec-head center reveal" style="margin-bottom:28px">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="social-cta reveal">
      {%- liquid
        assign ig = settings.social_instagram
        if ig == blank
          assign ig = section.settings.instagram_url
        endif
        assign fb = settings.social_facebook
        if fb == blank
          assign fb = section.settings.facebook_url
        endif
        assign tt = settings.social_tiktok
        if tt == blank
          assign tt = section.settings.tiktok_url
        endif
        if ig == blank
          assign ig = 'https://www.instagram.com/royalbeing2026/'
        endif
      -%}
      {%- if section.settings.instagram_label != blank and ig != blank -%}
        <a class="btn btn-outline" href="{{ ig }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>
      {%- endif -%}
      {%- if section.settings.facebook_label != blank and fb != blank -%}
        <a class="btn btn-outline" href="{{ fb }}" target="_blank" rel="noopener">{{ section.settings.facebook_label }}</a>
      {%- endif -%}
      {%- if section.settings.tiktok_label != blank and tt != blank -%}
        <a class="btn btn-outline" href="{{ tt }}" target="_blank" rel="noopener">{{ section.settings.tiktok_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Full-bleed square mosaic — 1:1 cells so script text is never cropped {%- endcomment -%}
  <div class="rb-ig reveal" aria-label="Royal Being soap gallery">
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-calm.png' | asset_url }}" alt="Calm — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-floral.png' | asset_url }}" alt="Fresh Floral Fiesta — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell rb-ig__cta" href="{{ ig }}" target="_blank" rel="noopener" aria-label="Follow @royalbeing2026 on Instagram">
      <span class="rb-ig__cta-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="5"/>
          <circle cx="12" cy="12" r="4.2"/>
          <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <span class="rb-ig__cta-text">@ROYALBEING2026<br>ON INSTAGRAM</span>
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-lavender.png' | asset_url }}" alt="Blissful Lavender — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-gilded.png' | asset_url }}" alt="Gilded Age — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-aquatic.png' | asset_url }}" alt="Aquatic Escape — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-citrus.png' | asset_url }}" alt="Citrus Heaven — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-tallow.png' | asset_url }}" alt="Beef Tallow — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-charcoal.png' | asset_url }}" alt="Charcoal Moment — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-aloe.png' | asset_url }}" alt="Aloe Vera Wave — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-detoxify.png' | asset_url }}" alt="Detoxify — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
    <a class="rb-ig__cell" href="{{ ig }}" target="_blank" rel="noopener">
      <img src="{{ 'rb-social-slow-life.png' | asset_url }}" alt="Slow Life — Royal Being" loading="lazy" width="1000" height="1000">
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Social media",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FOLLOW THE RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@royalbeing2026" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Follow Royal Being for new soap reveals, behind-the-scenes moments, collection launches, lathering videos, skincare rituals, and small-batch updates." },
    { "type": "text", "id": "instagram_label", "label": "Instagram button", "default": "FOLLOW ON INSTAGRAM" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL fallback" },
    { "type": "text", "id": "facebook_label", "label": "Facebook button", "default": "FOLLOW ON FACEBOOK" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL fallback" },
    { "type": "text", "id": "tiktok_label", "label": "TikTok button", "default": "FOLLOW ON TIKTOK" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL fallback" }
  ],
  "presets": [{ "name": "Social media" }]
}
{% endschema %}
