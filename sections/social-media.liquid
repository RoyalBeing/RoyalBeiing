<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap center">
    <div class="sec-head center reveal" style="margin-bottom:28px">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="social-cta reveal" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
      {%- if section.settings.instagram_label != blank -%}
        <a class="btn btn-outline" href="{{ settings.social_instagram | default: section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>
      {%- endif -%}
      {%- if section.settings.facebook_label != blank -%}
        <a class="btn btn-outline" href="{{ settings.social_facebook | default: section.settings.facebook_url }}" target="_blank" rel="noopener">{{ section.settings.facebook_label }}</a>
      {%- endif -%}
      {%- if section.settings.tiktok_label != blank -%}
        <a class="btn btn-outline" href="{{ settings.social_tiktok | default: section.settings.tiktok_url }}" target="_blank" rel="noopener">{{ section.settings.tiktok_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social media",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FOLLOW THE RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@royalbeing2026" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Follow Royal Being for new soap reveals, behind-the-scenes moments, collection launches, lathering videos, skincare rituals, and small-batch updates." },
    { "type": "text", "id": "instagram_label", "label": "Instagram button", "default": "FOLLOW ON INSTAGRAM" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL fallback", "default": "https://www.instagram.com/royalbeing2026/" },
    { "type": "text", "id": "facebook_label", "label": "Facebook button", "default": "FOLLOW ON FACEBOOK" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL fallback", "default": "https://www.facebook.com/profile.php?id=61591471053395" },
    { "type": "text", "id": "tiktok_label", "label": "TikTok button", "default": "FOLLOW ON TIKTOK" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL fallback", "default": "https://www.tiktok.com/@royaliik0ju" }
  ],
  "presets": [{ "name": "Social media" }]
}
{% endschema %}
