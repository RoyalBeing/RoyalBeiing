{%- liquid
  assign primary_href = section.settings.primary_link | default: '/collections/royal-duke'
  assign secondary_href = section.settings.secondary_link | default: routes.collections_url
-%}
{%- render 'immersive-story',
  theme: 'duke',
  media_position: 'left',
  image: section.settings.image,
  fallback_asset: section.settings.fallback_asset,
  image_alt: section.settings.image_alt,
  image_position: section.settings.image_position,
  secondary_image: section.settings.secondary_image,
  secondary_asset: section.settings.secondary_asset,
  secondary_alt: section.settings.secondary_alt,
  secondary_position: section.settings.secondary_position,
  product_image: section.settings.product_image,
  product_asset: section.settings.product_asset,
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  text: section.settings.text,
  primary_label: section.settings.primary_label,
  primary_link: primary_href,
  primary_style: section.settings.primary_style,
  secondary_label: section.settings.secondary_label,
  secondary_link: secondary_href,
  fetchpriority: 'high',
  shopify_attributes: section.shopify_attributes
-%}

{% schema %}
{
  "name": "Ritual of Being",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE RITUAL OF BEING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Refined Care for the Modern Gentleman" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Deep cleanse with activated charcoal. Crafted with natural ingredients. Made for your daily ritual." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "SHOP THE ROYAL DUKE COLLECTION" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "select", "id": "primary_style", "label": "Primary button style", "options": [
      { "value": "btn-gold", "label": "Gold" },
      { "value": "btn-primary", "label": "Green" }
    ], "default": "btn-gold" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link", "default": "EXPLORE OUR COLLECTIONS" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Ambassador image" },
    { "type": "text", "id": "fallback_asset", "label": "Theme asset fallback", "default": "rb-amb-duke-ritual.jpg" },
    { "type": "text", "id": "image_alt", "label": "Main image alt", "default": "Royal Being male ambassador holding Charcoal Moment soap" },
    { "type": "text", "id": "image_position", "label": "Main object-position", "default": "52% 34%" },
    { "type": "image_picker", "id": "secondary_image", "label": "Inset image" },
    { "type": "text", "id": "secondary_asset", "label": "Inset asset fallback", "default": "rb-amb-charcoal-hands.jpg" },
    { "type": "text", "id": "secondary_alt", "label": "Inset alt", "default": "Hands holding Charcoal Moment activated charcoal soap" },
    { "type": "text", "id": "secondary_position", "label": "Inset object-position", "default": "18% 72%" },
    { "type": "image_picker", "id": "product_image", "label": "Foreground soap (optional)" },
    { "type": "text", "id": "product_asset", "label": "Foreground soap asset" }
  ],
  "presets": [{ "name": "Ritual of Being" }]
}
{% endschema %}
