<section class="hero" {{ section.shopify_attributes }}>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="hero__scrim"></div>
  <div class="hero__inner wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn-outline" href="{{ section.settings.button2_link }}" style="color:#fff;border-color:#fff">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Royal Being — The Ritual of Being" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Daily Cleansing into a Sacred Spa Ritual" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Herbal soaps that last and last — handmade and hand-poured in small batches." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop Soaps" },
    { "type": "url", "id": "button_link", "label": "Primary link", "default": "/collections/all" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Explore Collections" },
    { "type": "url", "id": "button2_link", "label": "Secondary link", "default": "/collections" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
