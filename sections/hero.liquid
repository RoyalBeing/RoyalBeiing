{%- liquid
  assign interval = section.settings.interval | default: 5500
  assign transition = section.settings.transition | default: 600
  assign slide_count = section.blocks.size
-%}
<section
  class="hero hero--slider hero--split"
  data-hero-slider
  data-interval="{{ interval }}"
  data-transition="{{ transition }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | default: 'Featured collections' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="hero__slides">
    {%- if slide_count > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop = block.settings.image
          assign mobile = block.settings.image_mobile
          if mobile == blank
            assign mobile = desktop
          endif
          assign panel = block.settings.panel | default: 'left'
          assign objpos = block.settings.object_position | default: 'center'
          assign fallback = block.settings.fallback_asset
        -%}
        <div
          class="hero__slide hero__slide--panel-{{ panel }}{% if forloop.first %} is-active{% endif %}"
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ slide_count }}"
          {{ block.shopify_attributes }}
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        >
          <div class="hero__media">
            {%- if desktop != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 1200 }}">
                {%- endif -%}
                <img
                  src="{{ desktop | image_url: width: 2400 }}"
                  srcset="{{ desktop | image_url: width: 900 }} 900w, {{ desktop | image_url: width: 1400 }} 1400w, {{ desktop | image_url: width: 2000 }} 2000w, {{ desktop | image_url: width: 2400 }} 2400w"
                  sizes="100vw"
                  alt="{{ desktop.alt | default: block.settings.heading | escape }}"
                  width="{{ desktop.width }}"
                  height="{{ desktop.height }}"
                  style="object-position: {{ objpos }}"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              </picture>
            {%- elsif fallback != blank -%}
              <img
                src="{{ fallback | asset_url }}"
                alt="{{ block.settings.heading | escape }}"
                width="2048"
                height="938"
                style="object-position: {{ objpos }}"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            {%- else -%}
              <img src="{{ 'rb-hero-royal.jpg' | asset_url }}" alt="{{ block.settings.heading | escape }}" width="2048" height="938" style="object-position: {{ objpos }}" loading="eager">
            {%- endif -%}
          </div>
          <div class="hero__panel">
            <div class="hero__inner">
              {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h1>{{ block.settings.heading }}</h1>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="hero__cta">
                  <a class="btn {% if panel == 'right' %}btn-gold{% else %}btn-outline{% endif %}" href="{{ block.settings.button_link | default: routes.collections_url }}">{{ block.settings.button_label }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}Default three collection slides{%- endcomment -%}
      <div class="hero__slide hero__slide--panel-left is-active" data-slide role="group" aria-roledescription="slide" aria-label="1 of 3">
        <div class="hero__media">
          <img src="{{ 'rb-hero-royal.jpg' | asset_url }}" alt="The Royal Collection" width="2048" height="938" style="object-position: 78% center" loading="eager" fetchpriority="high">
        </div>
        <div class="hero__panel">
          <div class="hero__inner">
            <p class="eyebrow">THE ROYAL COLLECTION</p>
            <h1>Turn Your Daily Cleanse Into a Royal Ritual</h1>
            <p>Luxurious herbal soaps, handmade in small batches to nourish your skin and elevate every moment of self-care.</p>
            <div class="hero__cta"><a class="btn btn-outline" href="/collections/royal">SHOP THE ROYAL COLLECTION</a></div>
          </div>
        </div>
      </div>
      <div class="hero__slide hero__slide--panel-right" data-slide role="group" aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true">
        <div class="hero__media">
          <img src="{{ 'rb-hero-duke.jpg' | asset_url }}" alt="The Royal Duke Collection" width="2048" height="936" style="object-position: 18% center" loading="lazy">
        </div>
        <div class="hero__panel">
          <div class="hero__inner">
            <p class="eyebrow">THE ROYAL DUKE COLLECTION</p>
            <h1>Refined Care for the Modern Gentleman</h1>
            <p>Bold, long-lasting herbal bars with rich woods, warm spices, and distinguished character.</p>
            <div class="hero__cta"><a class="btn btn-gold" href="/collections/royal-duke">SHOP THE ROYAL DUKE COLLECTION</a></div>
          </div>
        </div>
      </div>
      <div class="hero__slide hero__slide--panel-left" data-slide role="group" aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true">
        <div class="hero__media">
          <img src="{{ 'rb-hero-kid.jpg' | asset_url }}" alt="The Royal Kid Herbal Collection" width="2048" height="936" style="object-position: 82% center" loading="lazy">
        </div>
        <div class="hero__panel">
          <div class="hero__inner">
            <p class="eyebrow">THE ROYAL KID HERBAL COLLECTION</p>
            <h1>Gentle Rituals for Little Royal Beings</h1>
            <p>Thoughtfully crafted herbal soaps created to make bath time gentle, joyful, and special.</p>
            <div class="hero__cta"><a class="btn btn-outline" href="/collections/royal-kid">SHOP THE KIDS COLLECTION</a></div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- assign control_count = slide_count -%}
  {%- if control_count == 0 -%}{%- assign control_count = 3 -%}{%- endif -%}
  {%- if control_count > 1 -%}
    <div class="hero__controls wrap">
      <button type="button" class="hero__nav hero__nav--prev" data-hero-prev aria-label="Previous slide"><span aria-hidden="true">‹</span></button>
      <div class="hero__dots" role="tablist" aria-label="Slide pagination">
        {%- for i in (1..control_count) -%}
          <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" role="tab" aria-label="Go to slide {{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {%- endfor -%}
      </div>
      <button type="button" class="hero__nav hero__nav--next" data-hero-next aria-label="Next slide"><span aria-hidden="true">›</span></button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Carousel label", "default": "Featured collections" },
    { "type": "range", "id": "interval", "min": 4000, "max": 8000, "step": 500, "unit": "ms", "label": "Autoplay interval", "default": 5500 },
    { "type": "range", "id": "transition", "min": 400, "max": 800, "step": 100, "unit": "ms", "label": "Transition duration", "default": 600 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        { "type": "text", "id": "fallback_asset", "label": "Theme asset filename fallback", "info": "e.g. rb-hero-royal.jpg" },
        { "type": "select", "id": "panel", "label": "Text panel side", "options": [
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "left" },
        { "type": "text", "id": "object_position", "label": "Image object-position", "default": "center", "info": "e.g. 78% center" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROYAL COLLECTION" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Turn Your Daily Cleanse Into a Royal Ritual" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Luxurious herbal soaps, handmade in small batches to nourish your skin and elevate every moment of self-care." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE ROYAL COLLECTION" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "fallback_asset": "rb-hero-royal.jpg",
            "panel": "left",
            "object_position": "78% center",
            "eyebrow": "THE ROYAL COLLECTION",
            "heading": "Turn Your Daily Cleanse Into a Royal Ritual",
            "text": "Luxurious herbal soaps, handmade in small batches to nourish your skin and elevate every moment of self-care.",
            "button_label": "SHOP THE ROYAL COLLECTION"
          }
        },
        {
          "type": "slide",
          "settings": {
            "fallback_asset": "rb-hero-duke.jpg",
            "panel": "right",
            "object_position": "18% center",
            "eyebrow": "THE ROYAL DUKE COLLECTION",
            "heading": "Refined Care for the Modern Gentleman",
            "text": "Bold, long-lasting herbal bars with rich woods, warm spices, and distinguished character.",
            "button_label": "SHOP THE ROYAL DUKE COLLECTION"
          }
        },
        {
          "type": "slide",
          "settings": {
            "fallback_asset": "rb-hero-kid.jpg",
            "panel": "left",
            "object_position": "82% center",
            "eyebrow": "THE ROYAL KID HERBAL COLLECTION",
            "heading": "Gentle Rituals for Little Royal Beings",
            "text": "Thoughtfully crafted herbal soaps created to make bath time gentle, joyful, and special.",
            "button_label": "SHOP THE KIDS COLLECTION"
          }
        }
      ]
    }
  ]
}
{% endschema %}
