{%- liquid
  assign max_reviews = section.settings.max_reviews | default: 12
  assign shown = 0
  for block in section.blocks
    if block.type == 'review'
      if block.settings.name != blank and block.settings.body != blank
        if shown < max_reviews
          assign shown = shown | plus: 1
        endif
      endif
    endif
  endfor
  assign overall = section.settings.overall_rating | default: ''
  assign total = section.settings.total_reviews | default: ''
  assign google_leave_url = section.settings.google_review_url
  assign google_profile_url = section.settings.google_profile_url
-%}
<section
  class="section grev grev--split"
  id="google-reviews"
  data-google-reviews
  data-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="wrap">
    <div class="grev-split reveal">
      {%- comment -%} Left — community story {%- endcomment -%}
      <div class="grev-split__copy" id="share-review">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="grev-split__lead">{{ section.settings.text | newline_to_br }}</p>
        {%- endif -%}

        {%- if shown == 0 -%}
          <div class="grev-split__status">
            <p class="eyebrow">{{ section.settings.empty_eyebrow | default: 'COMING SOON' }}</p>
            <h3>{{ section.settings.empty_heading | default: 'Customer stories are on the way' }}</h3>
            <p>{{ section.settings.empty_text | default: 'Be among the first to share how Royal Being fits into your daily ritual.' }}</p>
          </div>
        {%- else -%}
          {%- if overall != blank or total != blank -%}
            <div class="grev-split__score">
              {%- if overall != blank -%}<span class="grev-split__rating">{{ overall }}</span>{%- endif -%}
              <span class="grev-split__stars" aria-hidden="true">★★★★★</span>
              {%- if total != blank -%}<span class="grev-split__count">{{ total }} community reviews</span>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="grev-split__actions">
          {%- if shown > 0 and section.settings.button_label != blank -%}
            <button type="button" class="btn btn-primary" data-grev-open-all>
              {{ section.settings.button_label }}
            </button>
          {%- endif -%}
          <a class="btn {% if shown > 0 %}btn-outline{% else %}btn-primary{% endif %}" href="#review-upload-form" data-review-form-open>
            {{ section.settings.button2_label | default: 'SHARE YOUR EXPERIENCE' }}
          </a>
        </div>
      </div>

      {%- comment -%} Right — share form {%- endcomment -%}
      <aside class="grev-split__form card-soft" aria-label="Share your review">
        {%- if section.settings.form_heading != blank -%}
          <h3 class="grev-split__form-title">{{ section.settings.form_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.form_text != blank -%}
          <p class="grev-split__form-lead">{{ section.settings.form_text }}</p>
        {%- endif -%}
        {%- if section.settings.form_consent != blank -%}
          <p class="note grev-split__form-note">{{ section.settings.form_consent }}</p>
        {%- endif -%}

        <div class="review-invite__form-wrap" id="review-upload-form">
          {%- form 'contact', id: 'RoyalBeingReviewForm', class: 'review-form' -%}
            <input type="hidden" name="contact[subject]" value="{{ section.settings.form_subject | default: 'Royal Being — customer review' | escape }}">
            <input type="hidden" name="contact[tags]" value="customer-review,media-review">

            {%- if form.posted_successfully? -%}
              <p class="form-status form-status--success" role="status">
                {{ section.settings.success_message | default: 'Thank you — your review was sent. If you included a media link, our team will review it before display.' }}
              </p>
            {%- else -%}
              {%- if form.errors -%}
                <div class="form-status form-status--error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="review-form__grid">
                <label class="form-field">
                  <span>Name</span>
                  <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required autocomplete="name">
                </label>
                <label class="form-field">
                  <span>Email</span>
                  <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required autocomplete="email">
                </label>
              </div>

              <label class="form-field">
                <span>Star rating</span>
                <select name="contact[rating]" required>
                  <option value="">Select a rating</option>
                  <option value="5">5 — Excellent</option>
                  <option value="4">4 — Very good</option>
                  <option value="3">3 — Good</option>
                  <option value="2">2 — Fair</option>
                  <option value="1">1 — Poor</option>
                </select>
              </label>

              <label class="form-field">
                <span>Your review</span>
                <textarea name="contact[body]" rows="4" required placeholder="{{ section.settings.review_placeholder | default: 'Share how Royal Being fits into your ritual…' | escape }}">{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </label>

              <label class="form-field">
                <span>Photo or video link (optional)</span>
                <input
                  type="url"
                  name="contact[media_link]"
                  placeholder="https:// — paste a Google Drive, Dropbox, or hosted file link"
                  inputmode="url"
                >
                <span class="note" style="display:block;margin-top:8px;text-align:left">
                  {%- if shop.email != blank -%}
                    Prefer email? Send media to
                    <a href="mailto:{{ shop.email }}?subject=Royal%20Being%20review%20media">{{ shop.email }}</a>.
                  {%- else -%}
                    Paste a shareable link. Media is moderated before display.
                  {%- endif -%}
                </span>
              </label>

              <label class="review-form__consent">
                <input type="checkbox" name="contact[consent]" value="yes" required>
                <span>{{ section.settings.consent_checkbox | default: 'I confirm I own the rights to this content and allow Royal Being to display my review and media publicly.' }}</span>
              </label>

              <button type="submit" class="btn btn-primary btn-block">{{ section.settings.submit_label | default: 'SUBMIT YOUR REVIEW' }}</button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </aside>
    </div>

    {%- comment -%} Review carousel below when live reviews exist {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="grev__app reveal" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- capture grev_json -%}
[
{%- assign json_i = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'review' and json_i < max_reviews -%}
    {%- if block.settings.name != blank and block.settings.body != blank -%}
      {%- if json_i > 0 -%},{%- endif -%}
      {%- assign json_i = json_i | plus: 1 -%}
      {%- assign initial = block.settings.name | strip | slice: 0, 1 | upcase -%}
      {
        "id": {{ block.id | json }},
        "name": {{ block.settings.name | json }},
        "initial": {{ initial | json }},
        "date": {{ block.settings.date_label | json }},
        "rating": {{ block.settings.rating | default: 5 | json }},
        "excerpt": {{ block.settings.excerpt | default: block.settings.body | truncate: 160 | json }},
        "body": {{ block.settings.body | json }},
        "avatar": {% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 160 | json }}{% else %}null{% endif %},
        "verified": {{ block.settings.verified | json }},
        "google_url": {{ block.settings.google_url | json }},
        "reply": {{ block.settings.owner_reply | json }},
        "reply_label": {{ block.settings.owner_reply_label | default: 'OWNER REPLY' | json }}
      }
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
]
    {%- endcapture -%}
    <script type="application/json" data-grev-data>{{ grev_json | strip }}</script>

    {%- if shown > 0 -%}
      <div class="grev__carousel reveal" data-grev-carousel>
        <button type="button" class="grev__nav grev__nav--prev" data-grev-prev aria-label="Previous reviews">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="grev__viewport">
          <div class="grev__track" data-grev-track>
            {%- assign card_i = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and card_i < max_reviews -%}
                {%- if block.settings.name != blank and block.settings.body != blank -%}
                  {%- assign card_i = card_i | plus: 1 -%}
                  {%- assign initial = block.settings.name | strip | slice: 0, 1 | upcase -%}
                  {%- assign excerpt = block.settings.excerpt | default: block.settings.body | truncate: 160 -%}
                  {%- assign rating = block.settings.rating | default: 5 -%}
                  <div class="grev__slide" data-grev-slide {{ block.shopify_attributes }}>
                    <article class="grev-card" data-grev-open data-grev-id="{{ block.id }}">
                      <div class="grev-card__top">
                        <div class="grev-card__who">
                          {%- if block.settings.avatar != blank -%}
                            <img class="grev-card__avatar" src="{{ block.settings.avatar | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
                          {%- else -%}
                            <span class="grev-card__initial" aria-hidden="true">{{ initial }}</span>
                          {%- endif -%}
                          <div>
                            <div class="grev-card__name">{{ block.settings.name }}</div>
                            {%- if block.settings.date_label != blank -%}<div class="grev-card__date">{{ block.settings.date_label }}</div>{%- endif -%}
                          </div>
                        </div>
                        <div class="grev-card__stars" aria-label="{{ rating }} out of 5 stars">
                          {%- for i in (1..5) -%}{% if i <= rating %}★{% else %}☆{% endif %}{%- endfor -%}
                        </div>
                      </div>
                      <p class="grev-card__excerpt">{{ excerpt }}</p>
                      {%- if block.settings.verified -%}<span class="grev-card__verified">Verified</span>{%- endif -%}
                    </article>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <button type="button" class="grev__nav grev__nav--next" data-grev-next aria-label="Next reviews">
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <div class="grev__dots" data-grev-dots role="tablist" aria-label="Review pages"></div>
    {%- endif -%}
  </div>

  <div class="grev-modal" data-grev-modal hidden>
    <div class="grev-modal__backdrop" data-grev-close tabindex="-1"></div>
    <div
      class="grev-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="grev-modal-title-{{ section.id }}"
      data-grev-dialog
      tabindex="-1"
    >
      <button type="button" class="grev-modal__x" data-grev-close aria-label="Close reviews">
        <span aria-hidden="true">×</span>
      </button>
      <div class="grev-modal__head">
        <h3 id="grev-modal-title-{{ section.id }}" class="grev-modal__title">
          {{ section.settings.modal_title | default: 'Customer Reviews' }}
        </h3>
        <div class="grev-modal__score" data-grev-score>
          {%- if overall != blank -%}
            <span class="grev-modal__rating" data-grev-overall>{{ overall }}</span>
            <span class="grev-modal__stars" aria-hidden="true">★★★★★</span>
            {%- if total != blank -%}<span class="grev-modal__count" data-grev-total>({{ total }})</span>{%- endif -%}
          {%- endif -%}
        </div>
      </div>
      <div class="grev-modal__body" data-grev-modal-body></div>
      <div class="grev-modal__foot">
        {%- if google_profile_url != blank -%}
          <a class="btn btn-outline btn-sm" data-grev-view-google href="{{ google_profile_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.view_google_label | default: 'View on Google' }}</a>
        {%- else -%}
          <a class="btn btn-outline btn-sm" data-grev-view-google hidden target="_blank" rel="noopener noreferrer">{{ section.settings.view_google_label | default: 'View on Google' }}</a>
        {%- endif -%}
        {%- if google_leave_url != blank -%}
          <a class="btn btn-primary btn-sm" href="{{ google_leave_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.leave_google_label | default: 'Leave a Google Review' }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community & reviews",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Left — community copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROYAL COMMUNITY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Rituals. Real Experiences." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover how customers are making Royal Being part of their daily skincare and wellness rituals. Read genuine experiences shared by our growing community." },
    { "type": "text", "id": "empty_eyebrow", "label": "Empty-state eyebrow", "default": "COMING SOON" },
    { "type": "text", "id": "empty_heading", "label": "Empty-state heading", "default": "Customer stories are on the way" },
    { "type": "textarea", "id": "empty_text", "label": "Empty-state text", "default": "Be among the first to share how Royal Being fits into your daily ritual." },
    { "type": "text", "id": "button_label", "label": "Read reviews button", "default": "READ ALL REVIEWS" },
    { "type": "text", "id": "button2_label", "label": "Share button", "default": "SHARE YOUR EXPERIENCE" },

    { "type": "header", "content": "Right — review form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Share Your Royal Being Ritual" },
    { "type": "textarea", "id": "form_text", "label": "Form text", "default": "Show us how Royal Being fits into your self-care routine. Upload a photo or video with your review and help inspire our growing community." },
    { "type": "textarea", "id": "form_consent", "label": "Consent notice", "default": "By uploading media, you confirm you own the rights to the content and grant Royal Being permission to display it publicly on this website and social channels. Do not upload images of minors without parental consent." },
    { "type": "text", "id": "form_subject", "label": "Form email subject", "default": "Royal Being — customer review" },
    { "type": "text", "id": "review_placeholder", "label": "Review placeholder", "default": "Share how Royal Being fits into your ritual…" },
    { "type": "text", "id": "consent_checkbox", "label": "Consent checkbox", "default": "I confirm I own the rights to this content and allow Royal Being to display my review and media publicly." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "SUBMIT YOUR REVIEW" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you — your review was sent. If you included a media link, our team will review it before display." },

    { "type": "header", "content": "Reviews data" },
    { "type": "url", "id": "google_review_url", "label": "Google review-request URL" },
    { "type": "url", "id": "google_profile_url", "label": "Google reviews / profile URL" },
    { "type": "text", "id": "overall_rating", "label": "Overall rating" },
    { "type": "text", "id": "total_reviews", "label": "Total review count" },
    { "type": "range", "id": "max_reviews", "min": 4, "max": 24, "step": 1, "label": "Maximum reviews displayed", "default": 12 },
    { "type": "text", "id": "modal_title", "label": "Modal title", "default": "Customer Reviews" },
    { "type": "text", "id": "view_google_label", "label": "View on Google label", "default": "View on Google" },
    { "type": "text", "id": "leave_google_label", "label": "Leave a Google Review label", "default": "Leave a Google Review" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "text", "id": "date_label", "label": "Date label" },
        { "type": "textarea", "id": "excerpt", "label": "Card excerpt" },
        { "type": "textarea", "id": "body", "label": "Full review text" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true },
        { "type": "url", "id": "google_url", "label": "Link to this review" },
        { "type": "textarea", "id": "owner_reply", "label": "Owner reply (optional)" },
        { "type": "text", "id": "owner_reply_label", "label": "Owner reply badge", "default": "OWNER REPLY" }
      ]
    }
  ],
  "presets": [{ "name": "Community & reviews" }]
}
{% endschema %}
