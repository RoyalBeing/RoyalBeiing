<section class="section" style="background:var(--rb-mist)" id="shop-by-ritual" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ritual-grid reveal">
      {%- for block in section.blocks -%}
        {%- liquid
          assign href = block.settings.link
          if block.settings.collection != blank
            assign col = collections[block.settings.collection]
            if col != blank
              assign href = col.url
            endif
          endif
        -%}
        <article class="ritual-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="btn btn-outline btn-sm" href="{{ href | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Ritual",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND WHAT YOUR SKIN CRAVES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Ritual" }
  ],
  "blocks": [
    {
      "type": "ritual",
      "name": "Ritual",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "GLOW AND RADIANCE" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Discover thoughtfully formulated bars created to support a fresh, polished, and luminous appearance." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "SHOP GLOWING RITUALS" },
        { "type": "collection", "id": "collection", "label": "Link collection" },
        { "type": "url", "id": "link", "label": "Or custom link" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by Ritual" }]
}
{% endschema %}
