{%- liquid
  assign primary_href = section.settings.primary_link | default: '/products/detoxify'
  assign secondary_href = section.settings.secondary_link | default: routes.collections_url
-%}
{%- render 'immersive-story',
  theme: 'detox',
  media_position: 'left',
  image: section.settings.image,
  fallback_asset: section.settings.fallback_asset,
  image_alt: section.settings.image_alt,
  image_position: section.settings.image_position,
  product_image: section.settings.product_image,
  product_asset: section.settings.product_asset,
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  text: section.settings.text,
  primary_label: section.settings.primary_label,
  primary_link: primary_href,
  primary_style: section.settings.primary_style,
  secondary_label: section.settings.secondary_label,
  secondary_link: secondary_href,
  shopify_attributes: section.shopify_attributes
-%}

{% schema %}
{
  "name": "Detoxify Ritual",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DETOXIFY RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Skincare" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Skin-loving ingredients to purify and balance. Enriching scents to calm the mind. Luxurious lathers that leave your skin renewed and radiant." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "SHOP DETOXIFY" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "select", "id": "primary_style", "label": "Primary button style", "options": [
      { "value": "btn-gold", "label": "Gold" },
      { "value": "btn-primary", "label": "Green" }
    ], "default": "btn-gold" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link", "default": "EXPLORE OUR COLLECTIONS" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Ambassador image" },
    { "type": "text", "id": "fallback_asset", "label": "Theme asset fallback", "default": "rb-amb-detox-bath.jpg" },
    { "type": "text", "id": "image_alt", "label": "Main image alt", "default": "Royal Being female ambassador holding Detoxify herbal soap" },
    { "type": "text", "id": "image_position", "label": "Main object-position", "default": "68% 28%" },
    { "type": "image_picker", "id": "product_image", "label": "Foreground soap (optional)" },
    { "type": "text", "id": "product_asset", "label": "Foreground soap asset" }
  ],
  "presets": [{ "name": "Detoxify Ritual" }]
}
{% endschema %}
