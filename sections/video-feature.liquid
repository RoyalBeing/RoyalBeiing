<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}
    </div>

    {%- liquid
      assign poster = section.settings.poster
      assign video = section.settings.video
      assign video_url = section.settings.video_url
      assign has_main = false
      if video != blank or video_url != blank
        assign has_main = true
      endif
    -%}

    <div class="filmstrip{% unless has_main %} filmstrip--empty{% endunless %} reveal" style="aspect-ratio: {{ section.settings.aspect_ratio | default: '16 / 9' }}">
      {%- if video != blank -%}
        {{ video | video_tag: image_size: '1200x', controls: true, muted: false, autoplay: false, loop: false, class: 'rb-video' }}
      {%- elsif video_url != blank -%}
        <video
          class="rb-video"
          controls
          playsinline
          preload="metadata"
          {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}
          aria-label="{{ section.settings.heading | escape }}"
        >
          <source src="{{ video_url }}" type="video/mp4">
        </video>
      {%- else -%}
        <div class="filmstrip__empty" role="img" aria-label="Promotional video coming soon">
          <p class="eyebrow" style="color:var(--rb-gold-500);margin:0 0 8px">Video</p>
          <p style="margin:0;color:rgba(250,247,240,.75)">Promotional film will appear here.</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="film-grid reveal">
        {%- for block in section.blocks -%}
          {%- if block.settings.video_url != blank -%}
            <figure class="film-grid__item" {{ block.shopify_attributes }}>
              <div class="filmstrip" style="aspect-ratio:16/9">
                <video class="rb-video" controls playsinline preload="metadata" aria-label="{{ block.settings.label | default: 'Royal Being film' | escape }}">
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              </div>
              {%- if block.settings.label != blank -%}
                <figcaption class="film-grid__label">{{ block.settings.label }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="center" style="margin-top:32px">
        <a class="btn btn-outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROYAL BEING EXPERIENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the Ritual in Motion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Step inside the world of Royal Being and discover how thoughtfully crafted herbal soaps can transform an ordinary routine into an elevated skincare and wellness experience.\n\nFrom the first touch of water to the final rich lather, every Royal Being bar is created to make your daily cleanse feel more intentional." },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "Or MP4 URL (Shopify Files / CDN)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "aspect_ratio", "label": "Aspect ratio", "default": "16 / 9" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "DISCOVER OUR STORY" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Additional film",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Film" },
        { "type": "text", "id": "video_url", "label": "MP4 URL" }
      ]
    }
  ],
  "presets": [{ "name": "Video feature" }]
}
{% endschema %}
