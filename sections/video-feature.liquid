{%- comment -%}
  Full-bleed film under the five collections. Shopify file 31725554565177.
{%- endcomment -%}
<section class="rb-film rb-film--spotlight" {{ section.shopify_attributes }}>
  {%- liquid
    assign poster = section.settings.poster
    assign video_url = 'https://cdn.shopify.com/videos/c/o/v/117cb97df2d84d3797ee650ab396e790.mp4'
  -%}
  <div class="rb-film__player is-muted" data-autoplay-video>
    <video
      class="rb-video"
      muted
      loop
      autoplay
      playsinline
      webkit-playsinline
      preload="auto"
      {% if poster != blank %}poster="{{ poster | image_url: width: 2000 }}"{% endif %}
      aria-label="Royal Being"
    >
      <source src="{{ video_url }}" type="video/mp4">
    </video>
    {% render 'video-sound-control' %}
  </div>
</section>

{% schema %}
{
  "name": "Video feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROYAL BEING EXPERIENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the Ritual in Motion" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "MP4 URL", "info": "Unused. This section plays the landscape film from Shopify Files." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "EXPLORE THE COLLECTIONS" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Video feature" }]
}
{% endschema %}
