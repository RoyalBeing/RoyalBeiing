<section class="section section--compact rb-film" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="rb-film__grid reveal">
      <div class="rb-film__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rb-film__text lead">{{ section.settings.text | newline_to_br }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- liquid
            assign story_href = ''
            if pages['about'] != blank
              assign story_href = pages['about'].url
            elsif section.settings.button_link != blank
              unless section.settings.button_link contains 'pages/about'
                assign story_href = section.settings.button_link
              endunless
            endif
            if story_href == blank
              assign story_href = routes.root_url | append: '#collections'
            endif
          -%}
          <a class="btn btn-outline" href="{{ story_href }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      <div class="rb-film__media">
        {%- liquid
          assign poster = section.settings.poster
          assign video = section.settings.video
          assign video_url = section.settings.video_url
        -%}
        {%- if video != blank -%}
          <div class="rb-film__player" data-hover-video>
            {{ video | video_tag: image_size: '1200x', controls: false, muted: true, autoplay: false, loop: true, class: 'rb-video', playsinline: true }}
            <span class="rb-film__hint" aria-hidden="true">Hover to play</span>
          </div>
        {%- elsif video_url != blank -%}
          <div class="rb-film__player" data-hover-video>
            <video
              class="rb-video"
              muted
              loop
              playsinline
              preload="metadata"
              {% if poster != blank %}poster="{{ poster | image_url: width: 1400 }}"{% else %}poster="{{ 'rb-hero.jpg' | asset_url }}"{% endif %}
              aria-label="{{ section.settings.heading | escape }}"
            >
              <source src="{{ video_url }}" type="video/mp4">
            </video>
            <span class="rb-film__hint" aria-hidden="true">Hover to play</span>
          </div>
        {%- else -%}
          <div class="rb-film__player rb-film__player--empty">
            <p class="note">Royal Being film coming soon.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ROYAL BEING EXPERIENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the Ritual in Motion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Step inside the world of Royal Being and discover how thoughtfully crafted herbal soaps can transform an ordinary routine into an elevated skincare and wellness experience.\n\nFrom the first touch of water to the final rich lather, every Royal Being bar is created to make your daily cleanse feel more intentional." },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "MP4 URL", "default": "https://cdn.shopify.com/videos/c/o/v/117cb97df2d84d3797ee650ab396e790.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "EXPLORE THE COLLECTIONS" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Uses the About page when it exists; otherwise falls back to Collections." }
  ],
  "presets": [{ "name": "Video feature" }]
}
{% endschema %}
