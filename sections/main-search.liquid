<section class="page-banner" {{ section.shopify_attributes }}>
  <div class="page-banner__scrim" style="position:absolute;inset:0;background:var(--rb-green-900)"></div>
  <div class="page-banner__inner wrap">
    <h1>{{ section.settings.heading }}</h1>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;max-width:640px;margin:0 auto 30px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}" aria-label="Search" style="flex:1;padding:14px 18px;border:1.5px solid var(--rb-line);border-radius:40px">
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      <p class="note center" style="margin-bottom:24px">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms }}”</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search soaps, ingredients, collections…" }
  ]
}
{% endschema %}
