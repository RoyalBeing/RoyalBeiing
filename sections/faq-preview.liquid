<section class="section" id="faq-preview" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="wrap" style="max-width:900px">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="accordion reveal">
      {%- for block in section.blocks -%}
        <div class="acc" {{ block.shopify_attributes }}>
          <button type="button" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="plus" aria-hidden="true">+</span>
          </button>
          <div class="acc__body">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>
        {%- if section.settings.button_label != blank -%}
          {%- liquid
            assign faq_href = ''
            if pages['faq'] != blank
              assign faq_href = pages['faq'].url
            elsif section.settings.button_link != blank
              unless section.settings.button_link contains 'pages/faq'
                assign faq_href = section.settings.button_link
              endunless
            endif
            if faq_href == blank
              assign faq_href = '#share-review'
            endif
          -%}
          <div class="center" style="margin-top:32px">
            <a class="btn btn-outline" href="{{ faq_href }}">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ preview",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEED ASSISTANCE?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Questions, Answered" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "STILL HAVE A QUESTION?" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "If blank or a missing FAQ page, links to the review section." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are Royal Being soaps handmade?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Yes. Royal Being soaps are handmade and hand-poured in carefully prepared small batches." }
      ]
    }
  ],
  "presets": [{ "name": "FAQ preview" }]
}
{% endschema %}
