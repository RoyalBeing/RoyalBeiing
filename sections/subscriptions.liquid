{%- liquid
  assign sub_col = collections[section.settings.collection]
  if sub_col != blank
    assign catalog = sub_col.products
  else
    assign catalog = collections.all.products
  endif

  assign button_label = section.settings.button_label | default: 'EXPLORE SUBSCRIPTIONS'
  assign shop_link = section.settings.button_link
  if shop_link == blank
    if sub_col != blank
      assign shop_link = sub_col.url
    else
      assign shop_link = routes.all_products_collection_url
    endif
  endif

  assign plan_name = ''
  assign plan_cadence = ''
  assign save_amount = ''
  assign save_label = ''
  assign plan_desc = ''
  assign plan_href = shop_link
  assign plan_found = false

  for product in catalog
    if plan_found == false and product.selling_plan_groups.size > 0
      for group in product.selling_plan_groups
        if plan_found == false
          for plan in group.selling_plans
            if plan_found == false
              assign plan_found = true
              assign plan_name = plan.name
              assign plan_href = product.url
              if plan.description != blank
                assign plan_desc = plan.description | strip_html | truncate: 160
              endif

              assign plan_cadence = ''
              for option in plan.options
                if plan_cadence == blank
                  assign plan_cadence = option.value
                else
                  assign plan_cadence = plan_cadence | append: ' · ' | append: option.value
                endif
              endfor
              if plan_cadence == blank and plan.recurring_deliveries
                assign plan_cadence = 'Deliver every month'
              endif

              assign adj = plan.price_adjustments.first
              if adj != blank
                if adj.value_type == 'percentage'
                  assign save_amount = adj.value | append: '%'
                  assign save_label = adj.value | append: '% off with subscription'
                elsif adj.value_type == 'fixed_amount'
                  assign save_amount = adj.value | money
                  assign save_label = adj.value | money | append: ' off with subscription'
                elsif adj.value_type == 'price'
                  assign save_amount = adj.value | money
                  assign save_label = 'From ' | append: adj.value | money
                endif
              endif
            endif
          endfor
        endif
      endfor
    endif
  endfor

  if plan_name == blank
    assign plan_name = section.settings.fallback_name | default: 'Deliver every month, 20% off'
  endif
  if plan_cadence == blank
    assign plan_cadence = section.settings.fallback_cadence | default: 'Deliver every month'
  endif
  if save_amount == blank
    assign save_amount = section.settings.fallback_save | default: '20%'
  endif
  if save_label == blank
    assign save_label = section.settings.fallback_save_label | default: '20% off with subscription'
  endif
  if plan_desc == blank
    assign plan_desc = section.settings.fallback_desc | default: 'Keep your favourite Royal Being bars delivered on a schedule you choose. Cancel or pause anytime.'
  endif

  assign benefit_1 = section.settings.benefit_1 | default: 'Recurring delivery on eligible soaps'
  assign benefit_2 = section.settings.benefit_2 | default: 'Manage or skip upcoming orders in your account'
  assign benefit_3 = section.settings.benefit_3 | default: 'Cancel or pause anytime'
-%}

<section class="section rb-subs" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="rb-subs__split reveal">
      <div class="rb-subs__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rb-subs__lead">{{ section.settings.text | newline_to_br }}</div>
        {%- endif -%}
        <ul class="rb-subs__checklist">
          {%- if benefit_1 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_1 }}</span></li>
          {%- endif -%}
          {%- if benefit_2 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_2 }}</span></li>
          {%- endif -%}
          {%- if benefit_3 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_3 }}</span></li>
          {%- endif -%}
        </ul>
      </div>

      <article class="rb-subs__card">
        {%- if save_amount != blank -%}
          <span class="rb-subs__badge">SAVE {{ save_amount }}</span>
        {%- endif -%}
        <h3 class="rb-subs__name">{{ plan_name }}</h3>
        {%- if plan_cadence != blank -%}
          <p class="rb-subs__tagline">{{ plan_cadence }}</p>
        {%- endif -%}
        {%- if save_amount != blank -%}
          <div class="rb-subs__price">
            <span class="rb-subs__amount">{{ save_amount }} off</span>
          </div>
          {%- if save_label != blank -%}
            <p class="rb-subs__compare">{{ save_label }}</p>
          {%- endif -%}
        {%- endif -%}
        {%- if plan_desc != blank -%}
          <p class="rb-subs__desc">{{ plan_desc }}</p>
        {%- endif -%}
        <ul class="rb-subs__features">
          {%- if benefit_1 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_1 }}</span></li>
          {%- endif -%}
          {%- if benefit_2 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_2 }}</span></li>
          {%- endif -%}
          {%- if benefit_3 != blank -%}
            <li>{% render 'icon', name: 'check' %}<span>{{ benefit_3 }}</span></li>
          {%- endif -%}
        </ul>
        <a class="btn btn-primary btn-block" href="{{ plan_href }}">{{ button_label }}</a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscriptions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR RITUAL, DELIVERED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never Run Out of Your Favourite Soap" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Turn your favourite Royal Being bars into a dependable monthly ritual. Choose eligible soaps for recurring delivery and enjoy a more convenient way to keep your skincare routine beautifully stocked.\n\nManage your subscription through your customer account and adjust upcoming deliveries whenever needed."
    },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Recurring delivery on eligible soaps" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Manage or skip upcoming orders in your account" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Cancel or pause anytime" },
    { "type": "collection", "id": "collection", "label": "Subscription products collection", "info": "Leave blank to use the first live Shopify subscription plan found on any product." },
    { "type": "text", "id": "button_label", "label": "Card button", "default": "EXPLORE SUBSCRIPTIONS" },
    { "type": "url", "id": "button_link", "label": "Fallback shop link" },
    { "type": "header", "content": "Fallback card (if no live plan found)" },
    { "type": "text", "id": "fallback_name", "label": "Plan name", "default": "Deliver every month, 20% off" },
    { "type": "text", "id": "fallback_cadence", "label": "Cadence", "default": "Deliver every month" },
    { "type": "text", "id": "fallback_save", "label": "Save amount", "default": "20%" },
    { "type": "text", "id": "fallback_save_label", "label": "Save label", "default": "20% off with subscription" },
    { "type": "textarea", "id": "fallback_desc", "label": "Description", "default": "Keep your favourite Royal Being bars delivered on a schedule you choose. Cancel or pause anytime." }
  ],
  "presets": [{ "name": "Subscriptions" }]
}
{% endschema %}
