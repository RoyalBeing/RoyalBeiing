<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="card-soft reveal" style="max-width:920px;margin:0 auto;text-align:center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead" style="margin-inline:auto">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="sub-benefits">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: 'check' %}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" style="margin-top:10px">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="note" style="margin-top:18px">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscriptions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR RITUAL, DELIVERED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never Run Out of Your Favourite Soap" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Turn your favourite Royal Being bars into a dependable monthly ritual. Choose eligible soaps for recurring delivery and enjoy a more convenient way to keep your skincare routine beautifully stocked.\n\nManage your subscription through your customer account and adjust upcoming deliveries whenever needed." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "EXPLORE SUBSCRIPTIONS" },
    { "type": "url", "id": "button_link", "label": "Subscription / shop link" },
    { "type": "text", "id": "note", "label": "Note", "default": "Connect this button to your installed subscription app or eligible collection in the Theme Editor." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit", "default": "Convenient monthly delivery" }
      ]
    }
  ],
  "presets": [{
    "name": "Subscriptions",
    "blocks": [
      { "type": "benefit", "settings": { "text": "Convenient monthly delivery" } },
      { "type": "benefit", "settings": { "text": "Select eligible soaps" } },
      { "type": "benefit", "settings": { "text": "Manage subscriptions online" } },
      { "type": "benefit", "settings": { "text": "Update future deliveries" } },
      { "type": "benefit", "settings": { "text": "Maintain a consistent personal ritual" } }
    ]
  }]
}
{% endschema %}
