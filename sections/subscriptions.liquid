{%- liquid
  assign sub_col = collections[section.settings.collection]
  if sub_col != blank
    assign catalog = sub_col.products
  else
    assign catalog = collections.all.products
  endif

  assign button_label = section.settings.button_label | default: 'SUBSCRIBE TO THIS RITUAL'
  assign shop_label = section.settings.shop_label | default: 'SHOP ELIGIBLE SOAPS'
  assign shop_link = section.settings.button_link
  if shop_link == blank
    if sub_col != blank
      assign shop_link = sub_col.url
    else
      assign shop_link = routes.all_products_collection_url
    endif
  endif

  assign seen_ids = '|'
  assign plan_count = 0
  assign product_count = 0
  assign max_plans = section.settings.max_plans | default: 6
  assign max_products = section.settings.max_products | default: 8
-%}

<section class="section rb-subs" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}
    </div>

    {%- comment -%} Live Shopify Subscription selling plans {%- endcomment -%}
    {%- capture live_plans -%}
      {%- for product in catalog -%}
        {%- if product.selling_plan_groups.size > 0 -%}
          {%- for group in product.selling_plan_groups -%}
            {%- for plan in group.selling_plans -%}
              {%- assign needle = '|' | append: plan.id | append: '|' -%}
              {%- unless seen_ids contains needle -%}
                {%- if plan_count < max_plans -%}
                  {%- assign seen_ids = seen_ids | append: plan.id | append: '|' -%}
                  {%- assign plan_count = plan_count | plus: 1 -%}
                    {%- liquid
                    assign cadence = ''
                    for option in plan.options
                      if cadence == blank
                        assign cadence = option.value
                      else
                        assign cadence = cadence | append: ' · ' | append: option.value
                      endif
                    endfor
                    if cadence == blank and plan.recurring_deliveries
                      assign cadence = 'Recurring delivery'
                    endif

                    assign save_label = ''
                    assign save_amount = ''
                    assign adj = plan.price_adjustments.first
                    if adj != blank
                      if adj.value_type == 'percentage'
                        assign save_amount = adj.value | append: '%'
                        assign save_label = adj.value | append: '% off with subscription'
                      elsif adj.value_type == 'fixed_amount'
                        assign save_amount = adj.value | money
                        assign save_label = adj.value | money | append: ' off with subscription'
                      elsif adj.value_type == 'price'
                        assign save_amount = adj.value | money
                        assign save_label = 'From ' | append: adj.value | money
                      endif
                    endif
                  -%}
                  <article class="rb-subs__plan{% if plan_count == 1 %} rb-subs__plan--featured{% endif %}">
                    {%- if save_amount != blank -%}
                      <span class="rb-subs__badge">SAVE {{ save_amount }}</span>
                    {%- elsif group.name != blank and group.name != plan.name -%}
                      <span class="rb-subs__badge">{{ group.name | upcase | truncate: 28 }}</span>
                    {%- endif -%}
                    <h3 class="rb-subs__name">{{ plan.name }}</h3>
                    {%- if cadence != blank -%}
                      <p class="rb-subs__tagline">{{ cadence }}</p>
                    {%- endif -%}
                    {%- if save_amount != blank -%}
                      <div class="rb-subs__price">
                        <span class="rb-subs__amount">{{ save_amount }}</span>
                        <span class="rb-subs__cadence">off</span>
                      </div>
                      <p class="rb-subs__compare">{{ save_label }}</p>
                    {%- else -%}
                      <p class="rb-subs__compare">Subscribe &amp; save on eligible soaps</p>
                    {%- endif -%}
                    {%- if plan.description != blank -%}
                      <p class="rb-subs__desc">{{ plan.description | strip_html | truncate: 140 }}</p>
                    {%- else -%}
                      <p class="rb-subs__desc">Keep your favourite Royal Being bars delivered on a schedule you choose. Cancel or pause anytime.</p>
                    {%- endif -%}
                    <ul class="rb-subs__features">
                      <li>{% render 'icon', name: 'check' %}<span>Recurring delivery on eligible soaps</span></li>
                      <li>{% render 'icon', name: 'check' %}<span>Manage or skip upcoming orders in your account</span></li>
                      <li>{% render 'icon', name: 'check' %}<span>Cancel or pause anytime</span></li>
                    </ul>
                    <a class="btn {% if plan_count == 1 %}btn-primary{% else %}btn-outline{% endif %} btn-block" href="{{ product.url }}">{{ button_label }}</a>
                  </article>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if plan_count > 0 -%}
      <div class="rb-subs__grid reveal rb-subs__grid--{{ plan_count }}">
        {{ live_plans }}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      {%- comment -%} Manual fallback cards if live plans are not yet attached to products {%- endcomment -%}
      <div class="rb-subs__grid reveal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'plan' -%}
            <article class="rb-subs__plan{% if block.settings.featured %} rb-subs__plan--featured{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span class="rb-subs__badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if block.settings.name != blank -%}<h3 class="rb-subs__name">{{ block.settings.name }}</h3>{%- endif -%}
              {%- if block.settings.tagline != blank -%}<p class="rb-subs__tagline">{{ block.settings.tagline }}</p>{%- endif -%}
              <div class="rb-subs__price">
                {%- if block.settings.price != blank -%}<span class="rb-subs__amount">{{ block.settings.price }}</span>{%- endif -%}
                {%- if block.settings.cadence != blank -%}<span class="rb-subs__cadence">{{ block.settings.cadence }}</span>{%- endif -%}
              </div>
              {%- if block.settings.compare_price != blank -%}<p class="rb-subs__compare">{{ block.settings.compare_price }}</p>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="rb-subs__desc">{{ block.settings.description }}</p>{%- endif -%}
              {%- if block.settings.features != blank -%}
                <ul class="rb-subs__features">
                  {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign item = line | strip -%}
                    {%- if item != blank -%}
                      <li>{% render 'icon', name: 'check' %}<span>{{ item }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %} btn-block" href="{{ block.settings.button_link | default: shop_link }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="rb-subs__empty card-soft reveal center">
        <p class="lead" style="margin-inline:auto">Subscription plans will appear here once they are attached to eligible products.</p>
        <a class="btn btn-primary" href="{{ shop_link }}" style="margin-top:18px">{{ shop_label }}</a>
      </div>
    {%- endif -%}

    {%- comment -%} Eligible products with live selling plans {%- endcomment -%}
    {%- capture product_cards -%}
      {%- for product in catalog -%}
        {%- liquid
          assign is_sub = false
          if product.selling_plan_groups.size > 0
            assign is_sub = true
          elsif product.tags contains 'Subscription Eligible'
            assign is_sub = true
          endif
        -%}
        {%- if is_sub and product_count < max_products -%}
          {%- assign product_count = product_count | plus: 1 -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign plan_name = '' -%}
          {%- if product.selling_plan_groups.size > 0 -%}
            {%- assign plan_name = product.selling_plan_groups.first.selling_plans.first.name -%}
          {%- endif -%}
          <a class="rb-subs__product" href="{{ product.url }}">
            <span class="rb-subs__product-media">
              {%- if product.featured_media -%}
                <img
                  src="{{ product.featured_media | image_url: width: 600 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img src="{{ 'rb-ritual.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
              {%- endif -%}
            </span>
            <span class="rb-subs__product-body">
              <span class="rb-subs__product-name">{{ product.title }}</span>
              {%- if plan_name != blank -%}
                <span class="rb-subs__product-plan">{{ plan_name }}</span>
              {%- else -%}
                <span class="rb-subs__product-plan">Subscription eligible</span>
              {%- endif -%}
              <span class="rb-subs__product-price">{{ variant.price | money }}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if product_count > 0 -%}
      <div class="rb-subs__products reveal">
        <div class="rb-subs__products-head">
          <h3>Eligible soaps</h3>
          <a class="btn btn-outline btn-sm" href="{{ shop_link }}">{{ shop_label }}</a>
        </div>
        <div class="rb-subs__products-grid">
          {{ product_cards }}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="note center reveal" style="margin-top:28px;max-width:52ch;margin-inline:auto">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Subscriptions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR RITUAL, DELIVERED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never Run Out of Your Favourite Soap" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Turn your favourite Royal Being bars into a dependable monthly ritual. Choose eligible soaps for recurring delivery and enjoy a more convenient way to keep your skincare routine beautifully stocked.\n\nManage your subscription through your customer account and adjust upcoming deliveries whenever needed."
    },
    { "type": "collection", "id": "collection", "label": "Subscription products collection", "info": "Leave blank to scan all products for Shopify subscription plans." },
    { "type": "range", "id": "max_plans", "label": "Max subscription plans to show", "min": 1, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "max_products", "label": "Max eligible products to show", "min": 0, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Plan button label", "default": "SUBSCRIBE TO THIS RITUAL" },
    { "type": "text", "id": "shop_label", "label": "Eligible products button", "default": "SHOP ELIGIBLE SOAPS" },
    { "type": "url", "id": "button_link", "label": "Shop link" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Cancel or pause anytime. Manage deliveries through your customer account." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Manual plan (fallback)",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "Subscribe & Save" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Recurring delivery" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "text", "id": "cadence", "label": "Cadence", "default": "/ delivery" },
        { "type": "text", "id": "compare_price", "label": "Compare / save note", "default": "Cancel or pause anytime" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A dependable recurring delivery of your favourite Royal Being bar." },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Recurring delivery\nManage in your account\nCancel or pause anytime" },
        { "type": "checkbox", "id": "featured", "label": "Featured plan", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "SUBSCRIBE TO THIS RITUAL" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Subscriptions" }]
}
{% endschema %}
