<section class="section rb-subs" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rb-subs__grid reveal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'plan' -%}
            <article class="rb-subs__plan{% if block.settings.featured %} rb-subs__plan--featured{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <span class="rb-subs__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h3 class="rb-subs__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="rb-subs__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              <div class="rb-subs__price">
                {%- if block.settings.price != blank -%}
                  <span class="rb-subs__amount">{{ block.settings.price }}</span>
                {%- endif -%}
                {%- if block.settings.cadence != blank -%}
                  <span class="rb-subs__cadence">{{ block.settings.cadence }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.compare_price != blank -%}
                <p class="rb-subs__compare">{{ block.settings.compare_price }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="rb-subs__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.features != blank -%}
                <ul class="rb-subs__features">
                  {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign item = line | strip -%}
                    {%- if item != blank -%}
                      <li>
                        {% render 'icon', name: 'check' %}
                        <span>{{ item }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %} btn-block"
                  href="{{ block.settings.button_link | default: section.settings.button_link | default: routes.all_products_collection_url }}"
                >{{ block.settings.button_label }}</a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="note center reveal" style="margin-top:28px;max-width:52ch;margin-inline:auto">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Subscriptions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR RITUAL, DELIVERED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never Run Out of Your Favourite Soap" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Turn your favourite Royal Being bars into a dependable monthly ritual. Choose a subscription package and keep your skincare routine beautifully stocked." },
    { "type": "url", "id": "button_link", "label": "Default plan button link" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Cancel or pause anytime. Manage deliveries through your customer account." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Subscription plan",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "The Single Ritual" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "1 bar each month" },
        { "type": "text", "id": "price", "label": "Price", "default": "$18" },
        { "type": "text", "id": "cadence", "label": "Cadence", "default": "/ month" },
        { "type": "text", "id": "compare_price", "label": "Compare / save note", "default": "Cancel or pause anytime" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A dependable monthly delivery of your favourite Royal Being bar." },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "1 handmade soap bar\nFree shipping on recurring orders\nEasy skip or swap" },
        { "type": "checkbox", "id": "featured", "label": "Featured plan", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "CHOOSE THIS RITUAL" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{
    "name": "Subscriptions",
    "blocks": [
      {
        "type": "plan",
        "settings": {
          "name": "The Single Ritual",
          "tagline": "1 bar each month",
          "price": "$18",
          "cadence": "/ month",
          "compare_price": "Cancel or pause anytime",
          "description": "A dependable monthly delivery of your favourite Royal Being bar.",
          "features": "1 handmade soap bar\nFree shipping on recurring orders\nEasy skip or swap",
          "button_label": "CHOOSE THIS RITUAL"
        }
      },
      {
        "type": "plan",
        "settings": {
          "badge": "MOST LOVED",
          "name": "The Daily Pair",
          "tagline": "2 bars each month",
          "price": "$32",
          "cadence": "/ month",
          "compare_price": "Save vs buying separately",
          "description": "Keep sink and shower stocked with two curated bars every month.",
          "features": "2 handmade soap bars\nMix collections as you like\nFree shipping on recurring orders\nManage deliveries online",
          "featured": true,
          "button_label": "CHOOSE THIS RITUAL"
        }
      },
      {
        "type": "plan",
        "settings": {
          "name": "The Royal Household",
          "tagline": "3 bars each month",
          "price": "$45",
          "cadence": "/ month",
          "compare_price": "Best value for families",
          "description": "A fuller monthly ritual for shared bathrooms and gift-ready extras.",
          "features": "3 handmade soap bars\nIdeal for home + guest baths\nPriority restock access\nUpdate future deliveries anytime",
          "button_label": "CHOOSE THIS RITUAL"
        }
      }
    ]
  }]
}
{% endschema %}
