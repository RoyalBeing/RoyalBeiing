{%- assign rb_review_blog = blogs['reviews'] -%}
{%- assign rb_review_article = blank -%}
{%- if rb_review_blog != blank -%}
  {%- for rb_article in rb_review_blog.articles -%}
    {%- if rb_article.handle == 'customer-reviews' or rb_review_blog.articles.size == 1 -%}
      {%- assign rb_review_article = rb_article -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<section class="section review-invite" id="share-review" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="card-soft review-invite__card reveal">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead" style="margin-inline:auto">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.consent != blank -%}
        <p class="note" style="margin:18px auto 0;max-width:52ch">{{ section.settings.consent }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {%- if section.settings.button_link != blank and section.settings.button_link != '#review-form' and section.settings.button_link != '#share-review' -%}
          <a class="btn btn-gold" style="margin-top:22px" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- else -%}
          <a class="btn btn-gold" style="margin-top:22px" href="#review-upload-form" data-review-form-open>
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      {%- endif -%}

      {%- if rb_review_article != blank and rb_review_article.comments_count > 0 -%}
        <div class="rb-review-list" style="margin-top:28px;text-align:left">
          {%- for comment in rb_review_article.comments limit: 12 -%}
            {%- include 'rb-review-public' -%}
            <article class="rb-review-card">
              <h3>{{ comment.author }}</h3>
              <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%b %d, %Y' }}</time>
              {%- if rb_public_stars > 0 -%}
                <div class="grev-card__stars" aria-label="{{ rb_public_stars }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <span class="grev-star{% if i > rb_public_stars %} grev-star--empty{% endif %}" aria-hidden="true">★</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <p>{{ rb_public_body }}</p>
              {%- if rb_public_media != blank -%}
                <p class="rb-review-media"><a href="{{ rb_public_media }}" target="_blank" rel="noopener">View photo or video</a></p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="review-invite__form-wrap" id="review-upload-form">
        {%- if rb_review_article != blank -%}
          {%- form 'new_comment', rb_review_article, id: 'RoyalBeingReviewForm', class: 'review-form' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-status form-status--success" role="status">Thank you. Your star rating and written review are published on this page and on the product you selected.</p>
            {%- else -%}
              {%- if form.errors -%}
                <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
              {%- endif -%}
              <div class="review-form__grid">
                <label class="form-field">
                  <span>Name</span>
                  <input type="text" name="comment[author]" required autocomplete="name">
                </label>
                <label class="form-field">
                  <span>Email</span>
                  <input type="email" name="comment[email]" required autocomplete="email">
                </label>
              </div>
              <div class="review-form__grid">
                <label class="form-field">
                  <span>Star rating</span>
                  <select data-review-rating required>
                    <option value="">Select a rating</option>
                    <option value="5">5 — Excellent</option>
                    <option value="4">4 — Very good</option>
                    <option value="3">3 — Good</option>
                    <option value="2">2 — Fair</option>
                    <option value="1">1 — Poor</option>
                  </select>
                </label>
                <label class="form-field">
                  <span>Product</span>
                  <select data-review-product required>
                    <option value="">Select a product</option>
                    {%- for p in collections.all.products -%}
                      <option value="{{ p.title | escape }}">{{ p.title }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              </div>
              <label class="form-field">
                <span>Your review</span>
                <textarea name="comment[body]" rows="5" required placeholder="{{ section.settings.review_placeholder | default: 'Share how Royal Being fits into your ritual…' | escape }}"></textarea>
              </label>
              <label class="form-field">
                <span>Photo or video link <em>(optional)</em></span>
                <input type="url" data-review-media inputmode="url" placeholder="https:// — a photo, or a video of about 15 seconds">
              </label>
              <p class="note">Paste a shareable link. It is published with your review. A file cannot be attached in this form.</p>
              <button type="submit" class="btn btn-primary btn-block">{{ section.settings.submit_label | default: 'Submit review' }}</button>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Review media invite",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Share Your Royal Being Ritual" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Share how a Royal Being soap fits into your ritual. Your star rating and written review are published on this page and on the product you choose." },
    { "type": "textarea", "id": "consent", "label": "Consent notice", "default": "By uploading media, you confirm you own the rights to the content and grant Royal Being permission to display it publicly on this website and social channels. Do not upload images of minors without parental consent." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Share a review" },
    { "type": "url", "id": "button_link", "label": "External review app link (optional)", "info": "Leave blank to use the built-in review form on this page." },
    { "type": "text", "id": "form_subject", "label": "Form email subject", "default": "Royal Being — customer review" },
    { "type": "text", "id": "review_placeholder", "label": "Review placeholder", "default": "Share how Royal Being fits into your ritual…" },
    { "type": "text", "id": "consent_checkbox", "label": "Consent checkbox label", "default": "I confirm I own the rights to this content and allow Royal Being to display my review and media publicly." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "SUBMIT YOUR REVIEW" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you — your review was sent. If you included a media link, our team will review it before display." }
  ],
  "presets": [{ "name": "Review media invite" }]
}
{% endschema %}
