<section class="trust trust--benefits" {{ section.shopify_attributes }}>
  <div class="trust__grid wrap">
    {%- for block in section.blocks -%}
      <div class="trust__item trust__item--rich" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        <div>
          <div class="trust__label">{{ block.settings.label }}</div>
          {%- if block.settings.text != blank -%}
            <p class="trust__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "drop", "label": "Drop" },
          { "value": "heart", "label": "Heart" },
          { "value": "flag", "label": "Flag" },
          { "value": "check", "label": "Check" }
        ], "default": "leaf" },
        { "type": "text", "id": "label", "label": "Label", "default": "HANDMADE IN SMALL BATCHES" },
        { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Carefully crafted and hand-poured for freshness, quality, and attention to detail." }
      ]
    }
  ],
  "presets": [{
    "name": "Trust bar",
    "blocks": [
      { "type": "item", "settings": { "icon": "leaf", "label": "HANDMADE IN SMALL BATCHES", "text": "Carefully crafted and hand-poured for freshness, quality, and attention to detail." } },
      { "type": "item", "settings": { "icon": "drop", "label": "LONG-LASTING PREMIUM BARS", "text": "Generously sized herbal soaps created to last through ritual after ritual." } },
      { "type": "item", "settings": { "icon": "heart", "label": "NATURALLY INSPIRED", "text": "Made with nourishing oils, butters, botanicals, clays, milks, and mindful ingredients." } },
      { "type": "item", "settings": { "icon": "flag", "label": "FOR EVERY ROYAL BEING", "text": "Distinct collections for women, men, children, and a wide range of skincare preferences." } }
    ]
  }]
}
{% endschema %}
