<section class="section split{% if section.settings.reverse %} split--rev{% endif %}" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="split__media reveal">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
    {%- else -%}
      <img src="{{ 'rb-lifestyle-child.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
  </div>
  <div class="reveal" style="padding-inline:var(--pad-x)">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn {{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '#collections' }}" style="margin-top:18px">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ambassador editorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Ambassador image" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A RITUAL FOR EVERY ROYAL BEING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skincare That Feels Personal" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Royal Being celebrates the beauty of slowing down, reconnecting with yourself, and turning simple routines into meaningful moments.\n\nWhether your ritual is floral and elegant, rich and grounding, bright and refreshing, or calm and comforting, there is a Royal Being collection waiting for you." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "FIND YOUR COLLECTION" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "btn-primary", "label": "Primary" },
      { "value": "btn-outline", "label": "Outline" },
      { "value": "btn-gold", "label": "Gold" }
    ], "default": "btn-outline" }
  ],
  "presets": [{ "name": "Ambassador editorial" }]
}
{% endschema %}
