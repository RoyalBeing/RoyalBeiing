{%- render 'immersive-story',
  theme: 'family',
  media_position: 'right',
  image: section.settings.image,
  fallback_asset: section.settings.fallback_asset,
  image_alt: section.settings.image_alt,
  image_position: section.settings.image_position,
  mini_image: section.settings.mini_image,
  mini_asset: section.settings.mini_asset,
  mini_alt: section.settings.mini_alt,
  mini_position: section.settings.mini_position,
  mini_eyebrow: section.settings.mini_eyebrow,
  mini_label: section.settings.mini_label,
  mini_link: section.settings.mini_link | default: '/collections/royal-kid',
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  text: section.settings.text,
  primary_label: section.settings.primary_label,
  primary_link: section.settings.primary_link | default: '#collections',
  primary_style: section.settings.primary_style,
  secondary_label: section.settings.secondary_label,
  secondary_link: section.settings.secondary_link | default: '/collections/royal-kid',
  shopify_attributes: section.shopify_attributes
-%}

{% schema %}
{
  "name": "Family collections story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIVE COLLECTIONS. ONE ROYAL EXPERIENCE." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Naturally Gentle, Long Lasting Premium Bars, Made for Everyone" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtfully crafted with skin-loving ingredients for adults, families, and little ones. Pure, gentle, and made to be part of your everyday ritual." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "EXPLORE THE COLLECTIONS" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "select", "id": "primary_style", "label": "Primary button style", "options": [
      { "value": "btn-gold", "label": "Gold" },
      { "value": "btn-primary", "label": "Green" }
    ], "default": "btn-gold" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link", "default": "DISCOVER THE ROYAL KID'S COLLECTION" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Family image" },
    { "type": "text", "id": "fallback_asset", "label": "Theme asset fallback", "default": "rb-amb-family.jpg" },
    { "type": "text", "id": "image_alt", "label": "Main image alt", "default": "Royal Being family using premium soap collection" },
    { "type": "text", "id": "image_position", "label": "Main object-position", "default": "72% 42%" },
    { "type": "image_picker", "id": "mini_image", "label": "Royal Kid card image" },
    { "type": "text", "id": "mini_asset", "label": "Kid card asset fallback", "default": "rb-amb-child.jpg" },
    { "type": "text", "id": "mini_alt", "label": "Kid card alt", "default": "Child ambassador holding Royal Kid's Herbal soap" },
    { "type": "text", "id": "mini_position", "label": "Kid card object-position", "default": "48% 42%" },
    { "type": "text", "id": "mini_eyebrow", "label": "Kid card eyebrow", "default": "GENTLE & SAFE FOR LITTLE ONES" },
    { "type": "text", "id": "mini_label", "label": "Kid card link", "default": "Explore the Royal Kid's Herbal Collection" },
    { "type": "url", "id": "mini_link", "label": "Kid card URL" }
  ],
  "presets": [{ "name": "Family collections story" }]
}
{% endschema %}
