<section
  class="section section--compact pcar-section"
  style="background:var(--rb-mist)"
  data-product-carousel
  data-interval="{{ section.settings.interval | default: 5000 }}"
  {{ section.shopify_attributes }}
>
  <div class="wrap">
    <div class="sec-head center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- liquid
      assign col = collections[section.settings.collection]
      if col != blank
        assign catalog = col.products
      else
        assign catalog = collections.all.products
      endif
    -%}
    {%- capture rb_shared_json -%}{% render 'rb-catalog-shared' %}{%- endcapture -%}
    {%- assign rb_catalog = rb_shared_json | parse_json -%}
    {%- capture rb_json_royal -%}{% render 'rb-soaps-royal' %}{%- endcapture -%}
    {%- capture rb_json_signature -%}{% render 'rb-soaps-signature' %}{%- endcapture -%}
    {%- capture rb_json_common -%}{% render 'rb-soaps-common' %}{%- endcapture -%}
    {%- capture rb_json_duke -%}{% render 'rb-soaps-duke' %}{%- endcapture -%}
    {%- capture rb_json_kid -%}{% render 'rb-soaps-kid' %}{%- endcapture -%}
    {%- assign rb_pack_royal = rb_json_royal | parse_json -%}
    {%- assign rb_pack_signature = rb_json_signature | parse_json -%}
    {%- assign rb_pack_common = rb_json_common | parse_json -%}
    {%- assign rb_pack_duke = rb_json_duke | parse_json -%}
    {%- assign rb_pack_kid = rb_json_kid | parse_json -%}
    {%- include 'rb-orphan-soaps' -%}

    <div class="pcar reveal">
      <button type="button" class="pcar__nav pcar__nav--prev" data-pcar-prev aria-label="Previous products">
        <span aria-hidden="true">‹</span>
      </button>

      <div class="pcar__viewport">
        <div class="pcar__track" data-pcar-track>
          {%- comment -%} Active / available products first {%- endcomment -%}
          {%- for product in catalog -%}
            {%- if product.available -%}
              {% include 'rb-product-record' %}
              <div class="pcar__slide" data-pcar-slide>{% include 'product-card-carousel' %}</div>
            {%- endif -%}
          {%- endfor -%}
          {%- for product in catalog -%}
            {%- unless product.available -%}
              {% include 'rb-product-record' %}
              <div class="pcar__slide" data-pcar-slide>{% include 'product-card-carousel' %}</div>
            {%- endunless -%}
          {%- endfor -%}
          {%- if rb_orphan_count > 0 -%}
            {%- for h in rb_orphan_list -%}
              {%- assign rec = rb_pack_signature[h] -%}
              {%- if rec != blank -%}
                {%- assign price_cents = rec.price | times: 100 | round -%}
                {%- assign hero = rec.hero | default: 'rb-life-stack.jpg' -%}
                <div class="pcar__slide" data-pcar-slide>
<article class="pcar-card" data-catalog-handle="{{ rec.handle | escape }}" data-mood="citrus">
  <a class="pcar-card__media" href="/products/{{ rec.handle }}" aria-label="{{ rec.title | escape }}">
    <span class="pcar-card__stage" aria-hidden="true"></span>
    <span class="pcar-card__atm" aria-hidden="true"></span>
    <img class="pcar-card__soap" src="{{ hero | asset_url }}" alt="{{ rec.title | escape }}" loading="lazy" width="900" height="900">
  </a>
  <div class="pcar-card__body">
    <span class="pcar-card__coll">{{ rec.collection_title }}</span>
    <a class="pcar-card__name" href="/products/{{ rec.handle }}">{{ rec.title }}</a>
    <span class="pcar-card__price">{{ price_cents | money }}</span>
    <div class="pcar-card__actions">
      <a class="pcar-card__ritual" href="/products/{{ rec.handle }}">View ritual<span aria-hidden="true"> →</span></a>
    </div>
  </div>
</article>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <button type="button" class="pcar__nav pcar__nav--next" data-pcar-next aria-label="Next products">
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="pcar__dots" data-pcar-dots role="tablist" aria-label="Product pages"></div>

    {%- if section.settings.button_label != blank -%}
      <div class="center" style="margin-top:28px">
        <a class="btn btn-outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FEATURED RITUALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your New Favorite Bar" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Curated herbal soaps from across our collections." },
    { "type": "collection", "id": "collection", "label": "Collection (optional — leave blank for all)" },
    { "type": "range", "id": "interval", "min": 3000, "max": 8000, "step": 500, "unit": "ms", "label": "Auto-rotate interval", "default": 5000 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP ALL SOAPS" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
