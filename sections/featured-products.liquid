<section class="section" style="background:var(--rb-mist)" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="product-grid reveal">
      {%- liquid
        assign col = collections[section.settings.collection]
        assign limit = section.settings.products_to_show
      -%}
      {%- if col != blank -%}
        {%- for product in col.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="center" style="margin-top:40px">
        <a class="btn btn-outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-Batch Favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Soaps" },
    { "type": "collection", "id": "collection", "label": "Collection (optional — leave blank for all)" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Soaps" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
