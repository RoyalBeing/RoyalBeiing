<section class="section rb-ritual-banner" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="rb-ritual-banner__card reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rb-ritual-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rb-ritual-banner__heading">{{ section.settings.heading | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="rb-ritual-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-outline rb-ritual-banner__btn" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Daily ritual banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ROYAL BEING SKIN CARE" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "DISCOVER YOUR\nDAILY RITUAL" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Luxurious herbal soaps handmade in small batches to nourish the skin and bring elegance to everyday care." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP COLLECTION" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Daily ritual banner" }]
}
{% endschema %}
