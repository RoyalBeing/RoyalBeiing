{%- liquid
  assign pth = request.path | downcase
  assign is_about = false
  if pth contains '/pages/about' or pth contains '/pages/philosophy' or pth contains '/pages/terms'
    assign is_about = true
  endif
-%}
{%- capture rb_catalog_json -%}{% render 'rb-catalog-data' %}{%- endcapture -%}
{%- assign rb_catalog = rb_catalog_json | parse_json -%}
{%- assign virt_handle = pth | split: '/products/' | last | split: '/' | first | split: '?' | first -%}
{%- assign virt_rec = blank -%}
{%- if pth contains '/products/' and virt_handle != blank -%}
  {%- assign virt_rec = rb_catalog.products[virt_handle] -%}
{%- endif -%}
{%- assign is_virtual_product = false -%}
{%- if virt_rec != blank -%}
  {%- assign is_virtual_product = true -%}
{%- endif -%}
<div class="rb-about-virtual"{% unless is_about %} hidden{% endunless %}>
  {% render 'rb-about-page' %}
</div>
<div class="rb-virtual-product"{% unless is_virtual_product %} hidden{% endunless %}>
  {% render 'rb-virtual-product', rec: virt_rec, rb_catalog: rb_catalog, rb_handle: virt_handle %}
</div>
<div class="rb-404-fallback"{% if is_about or is_virtual_product %} hidden{% endif %}>
<section class="section" style="min-height:60vh;display:grid;place-items:center" {{ section.shopify_attributes }}>
  <div class="wrap center prose">
    <p class="eyebrow">Error 404</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead" style="margin-inline:auto">{{ section.settings.text }}</p>
    <p>
      <a class="btn btn-primary" href="{{ routes.root_url }}">{{ section.settings.home_label }}</a>
      <a class="btn btn-outline" href="{{ routes.collections_url }}">{{ section.settings.shop_label }}</a>
    </p>
  </div>
</section>
</div>
<script>
(function () {
  var p = (location.pathname || '').replace(/\/$/, '');
  var fallback = document.querySelector('.rb-404-fallback');
  if (/\/pages\/(about|about-us|philosophy|terms)(-conditions)?$/.test(p)) {
    document.documentElement.classList.add('rb-about-route');
    document.title = 'About Us · Royal Being';
    var about = document.querySelector('.rb-about-virtual');
    if (about) { about.hidden = false; }
    if (fallback) { fallback.hidden = true; }
    return;
  }
  var m = p.match(/\/products\/([a-z0-9-]+)$/i);
  var virtual = document.querySelector('.rb-virtual-product');
  if (m && virtual && virtual.querySelector('[data-virtual-product="' + m[1] + '"]')) {
    document.documentElement.classList.add('rb-product-route');
    var heading = virtual.querySelector('h1');
    if (heading) document.title = heading.textContent + ' · Royal Being';
    virtual.hidden = false;
    if (fallback) { fallback.hidden = true; }
  }
})();
</script>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page you’re looking for doesn’t exist — but your ritual awaits." },
    { "type": "text", "id": "home_label", "label": "Home button", "default": "Return Home" },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop Soaps" }
  ]
}
{% endschema %}
