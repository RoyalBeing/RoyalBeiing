{%- liquid
  assign h = collection.handle
  assign col_key = h
  if h == 'the-royal-collection'
    assign col_key = 'royal'
  elsif h == 'the-signature-collection'
    assign col_key = 'signature'
  elsif h == 'the-common-collection'
    assign col_key = 'common'
  elsif h == 'the-royal-duke-collection'
    assign col_key = 'royal-duke'
  elsif h == 'the-royal-kid-herbal-collection' or h == 'the-royal-kid-collection'
    assign col_key = 'royal-kid'
  endif
-%}
{%- comment -%} Catalog packs live in this section so a missing snippet cannot print an error. {%- endcomment -%}
{%- capture rb_shared_json -%}{% render 'rb-catalog-shared' %}{%- endcapture -%}
{%- assign rb_shared_json = rb_shared_json | strip -%}
{%- assign rb_catalog = rb_shared_json | parse_json -%}
{%- capture rb_json_royal -%}{% render 'rb-soaps-royal' %}{%- endcapture -%}
{%- assign rb_json_royal = rb_json_royal | strip -%}
{%- assign rb_pack_royal = rb_json_royal | parse_json -%}
{%- capture rb_json_signature -%}{% render 'rb-soaps-signature' %}{%- endcapture -%}
{%- assign rb_json_signature = rb_json_signature | strip -%}
{%- assign rb_pack_signature = rb_json_signature | parse_json -%}
{%- capture rb_json_common -%}{% render 'rb-soaps-common' %}{%- endcapture -%}
{%- assign rb_json_common = rb_json_common | strip -%}
{%- assign rb_pack_common = rb_json_common | parse_json -%}
{%- capture rb_json_duke -%}{% render 'rb-soaps-duke' %}{%- endcapture -%}
{%- assign rb_json_duke = rb_json_duke | strip -%}
{%- assign rb_pack_duke = rb_json_duke | parse_json -%}
{%- capture rb_json_kid -%}{% render 'rb-soaps-kid' %}{%- endcapture -%}
{%- assign rb_json_kid = rb_json_kid | strip -%}
{%- assign rb_pack_kid = rb_json_kid | parse_json -%}
{%- assign rec = rb_catalog.col_records[col_key] -%}
{%- liquid
  assign banner_asset = blank
  assign banner_h = 341
  assign hero_editorial = false
  assign hero_plain = false
  assign hero_video = blank
  case col_key
    when 'royal'
      assign banner_asset = 'rb-banner-royal.jpg'
      assign banner_h = 576
      assign hero_editorial = true
    when 'signature'
      assign banner_asset = 'rb-banner-signature.jpg'
      assign banner_h = 576
      assign hero_editorial = true
    when 'common'
      assign banner_asset = 'rb-banner-common.jpg'
      assign banner_h = 576
      assign hero_editorial = true
    when 'royal-duke'
      assign banner_asset = 'rb-banner-duke.jpg'
      assign banner_h = 576
      assign hero_editorial = true
    when 'royal-kid'
      assign banner_asset = 'rb-banner-kid.jpg'
      assign banner_h = 576
      assign hero_editorial = true
    when 'all'
      assign banner_asset = 'rb-banner-all.jpg'
      assign banner_h = 576
      assign hero_plain = true
      assign hero_video = 'https://cdn.shopify.com/videos/c/vp/73d871756d4f43bd8e1c1f56dd667d75/73d871756d4f43bd8e1c1f56dd667d75.HD-1080p-7.2Mbps-90385254.mp4'
  endcase
  if collection.handle == 'all'
    assign hero_title = 'Shop All Soaps'
  else
    assign hero_title = rec.title | default: collection.title
  endif
-%}
<section class="page-banner col-hero{% if hero_editorial %} col-hero--editorial{% endif %}{% if hero_plain %} col-hero--plain{% endif %}" {{ section.shopify_attributes }}>
  {%- if hero_video != blank -%}
    <div class="page-banner__media col-hero__film is-muted" data-autoplay-video>
      <video
        class="col-hero__video"
        muted
        loop
        autoplay
        playsinline
        webkit-playsinline
        preload="metadata"
        poster="{{ banner_asset | asset_url }}"
        aria-label="{{ hero_title | escape }}"
      >
        <source src="{{ hero_video }}" type="video/mp4">
      </video>
      {% render 'video-sound-control' %}
    </div>
  {%- elsif banner_asset != blank -%}
    <div class="page-banner__media"><img src="{{ banner_asset | asset_url }}" alt="{{ hero_title | escape }}" width="1024" height="{{ banner_h }}" fetchpriority="high"></div>
  {%- elsif rec != blank and rec.hero != blank -%}
    <div class="page-banner__media"><img src="{{ rec.hero | asset_url }}" alt="{{ hero_title | escape }}" width="1024" height="341" fetchpriority="high"></div>
  {%- elsif collection.featured_image -%}
    <div class="page-banner__media"><img src="{{ collection.featured_image | image_url: width: 2400 }}" alt="{{ collection.title | escape }}" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}" fetchpriority="high"></div>
  {%- else -%}
    {%- capture rb_col_src -%}{% render 'rb-collection-fallback-image', collection: collection %}{%- endcapture -%}
    {%- if rb_col_src != blank -%}
      <div class="page-banner__media"><img src="{{ rb_col_src | strip }}" alt="{{ hero_title | escape }}" width="1024" height="341" fetchpriority="high"></div>
    {%- endif -%}
  {%- endif -%}
  <div class="page-banner__scrim" aria-hidden="true"></div>
  <div class="col-hero__copy">
    {%- if col_key == 'common' -%}
      <h1><span>The Common</span><br><span>Collection</span></h1>
      <p class="col-hero__deck">Clear, calm, everyday wellness.</p>
      <p class="col-hero__lead">Considered essentials for the daily ritual. The Common Collection makes wholesome, plant-based cleansing an effortless part of every morning and every evening.</p>
      <span class="col-hero__rule" aria-hidden="true"></span>
      <p class="col-hero__meta">7 herbal soaps · Everyday · Calm</p>
    {%- elsif col_key == 'royal' -%}
      <h1><span>The Royal</span><br><span>Collection</span></h1>
      <p class="col-hero__deck">Elegant, floral, and unmistakably regal.</p>
      <p class="col-hero__lead">Botanical opulence for the ritual of royalty. The Royal Collection gathers our most luxurious florals — rose, jasmine, and gilded blooms — into bars crafted for those who cleanse like royalty.</p>
      <span class="col-hero__rule" aria-hidden="true"></span>
      <p class="col-hero__meta">7 herbal soaps · Regal · Floral</p>
    {%- elsif col_key == 'signature' -%}
      <h1><span>The Signature</span><br><span>Collection</span></h1>
      <p class="col-hero__deck">Our flagship — balanced botanical luxury.</p>
      <p class="col-hero__lead">The heart of Royal Being. Ten signature bars spanning charcoal, citrus, turmeric, and our beloved Watermelon Fusion — the definitive expression of the house.</p>
      <span class="col-hero__rule" aria-hidden="true"></span>
      <p class="col-hero__meta">10 herbal soaps · Flagship · Balanced</p>
    {%- elsif col_key == 'royal-duke' -%}
      <h1><span>The Royal Duke</span><br><span>Collection</span></h1>
      <p class="col-hero__deck">Grounded, woody, and quietly powerful.</p>
      <p class="col-hero__lead">{{ rec.intro | default: "The Royal Duke Collection is a premium five-piece anthology of artisanal herbal soaps engineered specifically for the modern man who values rugged, sophisticated grooming. This collection merges bold, masculine aromatherapy with hard-working botanicals to deliver an authoritative clean that honors a man's daily skin health." | replace: 'Photographed from the real, tested bars.', '' | replace: 'Photographed from the real, tested bars', '' }}</p>
      <span class="col-hero__rule" aria-hidden="true"></span>
      <p class="col-hero__meta">5 herbal soaps · For Men · Woody</p>
    {%- elsif col_key == 'royal-kid' -%}
      <h1><span>The Royal Kid</span><br><span>Herbal Collection</span></h1>
      <p class="col-hero__deck">Soft, joyful, and gentle — premium care for little ones.</p>
      <p class="col-hero__lead">{{ rec.intro | default: "The Royal Kid Herbal Collection is an ultra-gentle, four-piece anthology of artisanal herbal soaps handcrafted to transform bath time into a playful, palace-worthy ritual. Engineered specifically for children's delicate skin, this collection blends whimsical, kid-friendly scents with deeply soothing botanicals to ensure a tear-free, skin-softening wash." | replace: 'whimiscal', 'whimsical' }}</p>
      <span class="col-hero__rule" aria-hidden="true"></span>
      <p class="col-hero__meta">4 herbal soaps · For Kids · Gentle</p>
    {%- elsif hero_plain -%}
      <h1 class="visually-hidden">{{ hero_title }}</h1>
    {%- else -%}
      <h1>{{ hero_title }}</h1>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Duke/Kid keep their existing ads above the product grid. Royal/Signature/Common get placeholder ads below the soap lineup. {%- endcomment -%}
{%- assign rb_ad_file = blank -%}
{%- assign rb_ad_label = blank -%}
{%- assign rb_ad_src = blank -%}
{%- assign rb_ad_below_grid = false -%}
{%- if col_key == 'royal-duke' -%}
  {%- assign rb_ad_file = 'rb-ad-duke-horizontal.mp4' -%}
  {%- assign rb_ad_label = 'The Royal Duke Collection' -%}
{%- elsif col_key == 'royal-kid' -%}
  {%- assign rb_ad_file = 'rb-ad-kid-bodhi.mp4' -%}
  {%- assign rb_ad_label = 'The Royal Kid Herbal Collection' -%}
{%- elsif col_key == 'royal' or col_key == 'signature' or col_key == 'common' -%}
  {%- assign rb_ad_below_grid = true -%}
  {%- assign rb_ad_src = 'https://cdn.shopify.com/videos/c/o/v/117cb97df2d84d3797ee650ab396e790.mp4' -%}
  {%- if col_key == 'royal' -%}
    {%- assign rb_ad_label = 'The Royal Collection' -%}
  {%- elsif col_key == 'signature' -%}
    {%- assign rb_ad_label = 'The Signature Collection' -%}
  {%- else -%}
    {%- assign rb_ad_label = 'The Common Collection' -%}
  {%- endif -%}
{%- endif -%}

{%- if rb_ad_file != blank -%}
<section class="rb-film rb-film--spotlight" aria-label="{{ rb_ad_label | escape }}">
  <div class="rb-film__player is-muted" data-autoplay-video>
    <video
      class="rb-video"
      muted
      loop
      autoplay
      playsinline
      webkit-playsinline
      preload="metadata"
      aria-label="{{ rb_ad_label | escape }}"
    >
      <source src="{{ rb_ad_file | asset_url }}" type="video/mp4">
    </video>
    {% render 'video-sound-control' %}
  </div>
</section>
{%- endif -%}
<section class="section col-story{% if hero_editorial %} col-story--after-hero{% endif %}">
  <div class="wrap">
    {%- if rec != blank -%}
      <div class="col-story__grid reveal">
        {%- unless hero_editorial -%}
        <div class="col-story__copy">
          <p class="lead">{{ rec.intro }}</p>
          {%- if rec.gift_set != blank or rec.sample_kit != blank -%}
            <p class="col-story__kits">
              {%- if rec.gift_set != blank -%}<span>Gift Set {{ rec.gift_set }}</span>{%- endif -%}
              {%- if rec.sample_kit != blank -%}<span>Sample Kit {{ rec.sample_kit }}</span>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
        {%- endunless -%}
        {%- if rec.schema != blank and col_key != 'royal-duke' and col_key != 'royal-kid' -%}
          <figure class="col-story__schema">
            <img src="{{ rec.schema | asset_url }}" alt="{{ rec.title | escape }} lineup" width="1200" height="900" loading="lazy">
          </figure>
        {%- endif -%}
      </div>
      {%- if rec.lifestyle.size > 0 and col_key != 'royal-duke' and col_key != 'royal-kid' -%}
        <div class="col-life reveal">
          {%- for img in rec.lifestyle limit: 4 -%}
            <img src="{{ img | asset_url }}" alt="{{ rec.title | escape }} lifestyle" width="800" height="1000" loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if rec.matrix != blank and col_key != 'royal-duke' and col_key != 'royal-kid' -%}
        <figure class="col-matrix reveal">
          <img src="{{ rec.matrix | asset_url }}" alt="{{ rec.title | escape }} skin type matrix" width="1600" height="1200" loading="lazy">
        </figure>
      {%- endif -%}
    {%- elsif collection.description != blank and hero_editorial == false -%}
      <div class="prose reveal" style="margin-bottom:40px">{{ collection.description }}</div>
    {%- endif -%}

    {%- include 'rb-orphan-soaps' -%}
    {%- assign extra_here = 0 -%}
    {%- if rb_orphan_count > 0 -%}
      {%- if collection.handle == 'all' -%}
        {%- assign extra_here = rb_orphan_count -%}
      {%- elsif col_key == 'signature' -%}
        {%- assign extra_here = rb_orphan_count -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign shown_count = collection.products_count | plus: extra_here -%}
    <div class="shop-toolbar">
      <span class="count">{{ shown_count }} soap{% if shown_count != 1 %}s{% endif %}</span>
    </div>
    <div class="product-grid product-grid--pop reveal">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- for product in collection.products -%}
          {% include 'rb-product-record' %}
          {% include 'product-card' %}
        {%- else -%}
          {%- if extra_here == 0 -%}<p>No products in this collection yet.</p>{%- endif -%}
        {%- endfor -%}
        {%- if extra_here > 0 and paginate.current_page == 1 -%}
          {%- for h in rb_orphan_list -%}
            {%- if collection.handle == 'all' or col_key == 'signature' -%}
              {% render 'rb-orphan-card', rb_handle: h, rb_layout: 'grid' %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <div class="pagination" style="grid-column:1/-1">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>
{%- if rb_ad_below_grid and rb_ad_src != blank -%}
<section class="rb-film rb-film--spotlight rb-film--collection-break" aria-label="{{ rb_ad_label | escape }}">
  <div class="rb-film__player is-muted" data-autoplay-video>
    <video
      class="rb-video"
      muted
      loop
      autoplay
      playsinline
      webkit-playsinline
      preload="metadata"
      aria-label="{{ rb_ad_label | escape }} advertisement placeholder"
    >
      <source src="{{ rb_ad_src }}" type="video/mp4">
    </video>
    {% render 'video-sound-control' %}
  </div>
</section>
{%- endif -%}
<section class="section col-story col-story--bundle">
  <div class="wrap">
    {%- if col_key == 'common' or col_key == 'royal' or col_key == 'signature' or col_key == 'royal-duke' or col_key == 'royal-kid' -%}
      {%- assign rb_bundle_total = 0 -%}
      {%- assign rb_bundle_ids = '' -%}
      {%- for product in collection.products -%}
        {%- assign rb_bv = product.selected_or_first_available_variant -%}
        {%- if rb_bv != blank and rb_bv.available -%}
          {%- assign rb_bundle_total = rb_bundle_total | plus: rb_bv.price -%}
          {%- if rb_bundle_ids != blank -%}{%- assign rb_bundle_ids = rb_bundle_ids | append: ',' -%}{%- endif -%}
          {%- assign rb_bundle_ids = rb_bundle_ids | append: rb_bv.id -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign rb_bundle_sale = rb_bundle_total | times: 75 | divided_by: 100 -%}
      {%- case col_key -%}
        {%- when 'royal-duke' -%}
          {%- assign rb_slides = 'rb-duke-ensemble-lineup.jpg|rb-schema-duke.jpg|rb-duke-ensemble-schematic.jpg|rb-duke-visual-4.jpg|rb-duke-visual-5.jpg' | split: '|' -%}
        {%- when 'royal' -%}
          {%- assign rb_slides = 'rb-schema-royal.jpg|rb-royal-visual-2.jpg|rb-royal-visual-3.jpg' | split: '|' -%}
        {%- when 'common' -%}
          {%- assign rb_slides = 'rb-schema-common.jpg|rb-common-visual-2.jpg|rb-common-visual-3.jpg' | split: '|' -%}
        {%- when 'signature' -%}
          {%- assign rb_slides = 'rb-schema-signature.jpg|rb-signature-visual-2.jpg|rb-signature-visual-3.jpg' | split: '|' -%}
        {%- when 'royal-kid' -%}
          {%- assign rb_slides = 'rb-schema-kid.jpg|rb-kid-visual-2.jpg|rb-kid-visual-3.jpg' | split: '|' -%}
        {%- else -%}
          {%- assign rb_slides = '' | split: '|' -%}
      {%- endcase -%}
      {%- if rb_bundle_ids != blank -%}
        <div class="col-bundle reveal">
          {%- if rb_slides.size > 0 -%}
            <div class="col-bundle__scroller" data-bundle-scroll>
              <button type="button" class="col-bundle__arrow col-bundle__arrow--prev" data-bundle-prev aria-label="Previous collection visual">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="col-bundle__track" data-bundle-track>
                {%- for slide in rb_slides -%}
                  <img src="{{ slide | asset_url }}" alt="{{ collection.title | escape }}" width="1024" height="1024" loading="lazy">
                {%- endfor -%}
              </div>
              <button type="button" class="col-bundle__arrow col-bundle__arrow--next" data-bundle-next aria-label="Next collection visual">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5.5 6.5 6.5-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {%- endif -%}
          <p class="col-bundle__kicker">The whole set</p>
          <h2>Buy the entire collection</h2>
          <p class="col-bundle__note">Every soap in {{ collection.title }}, added together, with 25% off the total.</p>
          <p class="col-bundle__price">
            <s>{{ rb_bundle_total | money }}</s>
            <b>{{ rb_bundle_sale | money }}</b>
          </p>
          <button
            type="button"
            class="btn btn-primary"
            data-buy-collection
            data-variants="{{ rb_bundle_ids }}"
            data-discount="ROYAL25"
          >Buy the entire collection</button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "label": "Products per page", "default": 24 }
  ]
}
{% endschema %}
