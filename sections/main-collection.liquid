{%- liquid
  assign h = collection.handle
  assign col_key = h
  if h == 'the-royal-collection'
    assign col_key = 'royal'
  elsif h == 'the-signature-collection'
    assign col_key = 'signature'
  elsif h == 'the-common-collection'
    assign col_key = 'common'
  elsif h == 'the-royal-duke-collection'
    assign col_key = 'royal-duke'
  elsif h == 'the-royal-kid-herbal-collection' or h == 'the-royal-kid-collection'
    assign col_key = 'royal-kid'
  endif
-%}
{%- include 'rb-load-packs' -%}
{%- assign rec = rb_catalog.col_records[col_key] -%}
<section class="page-banner col-hero" {{ section.shopify_attributes }}>
  {%- if rec != blank and rec.hero != blank -%}
    <div class="page-banner__media"><img src="{{ rec.hero | asset_url }}" alt="{{ rec.title | default: collection.title | escape }}" width="2000" height="1100"></div>
  {%- elsif collection.featured_image -%}
    <div class="page-banner__media"><img src="{{ collection.featured_image | image_url: width: 2000 }}" alt="{{ collection.title | escape }}" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}"></div>
  {%- else -%}
    {%- capture rb_col_src -%}{% render 'rb-collection-fallback-image', collection: collection %}{%- endcapture -%}
    {%- if rb_col_src != blank -%}
      <div class="page-banner__media"><img src="{{ rb_col_src | strip }}" alt="{{ collection.title | escape }}" width="2000" height="1100"></div>
    {%- endif -%}
  {%- endif -%}
  <div class="page-banner__scrim"></div>
  <div class="page-banner__inner wrap">
    <nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}">Shop</a> / {{ rec.title | default: collection.title }}</nav>
    <p class="eyebrow">{{ section.settings.eyebrow | default: 'Collection' }}</p>
    <h1>{% if collection.handle == 'all' %}Shop All Soaps{% else %}{{ rec.title | default: collection.title }}{% endif %}</h1>
  </div>
</section>

<section class="section col-story">
  <div class="wrap">
    {%- if rec != blank -%}
      <div class="col-story__grid reveal">
        <div class="col-story__copy">
          <p class="lead">{{ rec.intro }}</p>
          {%- if rec.gift_set != blank or rec.sample_kit != blank -%}
            <p class="col-story__kits">
              {%- if rec.gift_set != blank -%}<span>Gift Set {{ rec.gift_set }}</span>{%- endif -%}
              {%- if rec.sample_kit != blank -%}<span>Sample Kit {{ rec.sample_kit }}</span>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
        {%- if rec.schema != blank -%}
          <figure class="col-story__schema">
            <img src="{{ rec.schema | asset_url }}" alt="{{ rec.title | escape }} lineup" width="1200" height="900" loading="lazy">
          </figure>
        {%- endif -%}
      </div>
      {%- if rec.lifestyle.size > 0 -%}
        <div class="col-life reveal">
          {%- for img in rec.lifestyle limit: 4 -%}
            <img src="{{ img | asset_url }}" alt="{{ rec.title | escape }} lifestyle" width="800" height="1000" loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if rec.video != blank -%}
        <div class="col-film reveal" data-hover-video>
          {% render 'video-sound-control' %}
          <video
            playsinline
            webkit-playsinline
            muted
            loop
            preload="metadata"
            poster="{% if rec.hero != blank %}{{ rec.hero | asset_url }}{% endif %}"
            controls
          >
            <source src="{{ rec.video }}" type="video/mp4">
          </video>
        </div>
      {%- endif -%}
      {%- if rec.matrix != blank -%}
        <figure class="col-matrix reveal">
          <img src="{{ rec.matrix | asset_url }}" alt="{{ rec.title | escape }} skin type matrix" width="1600" height="1200" loading="lazy">
        </figure>
      {%- endif -%}
    {%- elsif collection.description != blank -%}
      <div class="prose reveal" style="margin-bottom:40px">{{ collection.description }}</div>
    {%- endif -%}

    {%- include 'rb-orphan-soaps' -%}
    {%- assign extra_here = 0 -%}
    {%- if rb_orphan_count > 0 -%}
      {%- if collection.handle == 'all' -%}
        {%- assign extra_here = rb_orphan_count -%}
      {%- elsif col_key == 'signature' -%}
        {%- assign extra_here = rb_orphan_count -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign shown_count = collection.products_count | plus: extra_here -%}
    <div class="shop-toolbar">
      <span class="count">{{ shown_count }} soap{% if shown_count != 1 %}s{% endif %}</span>
    </div>
    <div class="product-grid product-grid--pop reveal">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- for product in collection.products -%}
          {% include 'rb-product-record' %}
          {% include 'product-card' %}
        {%- else -%}
          {%- if extra_here == 0 -%}<p>No products in this collection yet.</p>{%- endif -%}
        {%- endfor -%}
        {%- if extra_here > 0 and paginate.current_page == 1 -%}
          {%- for h in rb_orphan_list -%}
            {%- assign rec = rb_pack_signature[h] -%}
            {%- if rec != blank -%}
              {%- if collection.handle == 'all' or rec.collection == col_key -%}
                {%- assign price_cents = rec.price | times: 100 | round -%}
                {%- assign hero = rec.hero | default: 'rb-life-stack.jpg' -%}
<article class="pcard pcard--pop" data-catalog-handle="{{ rec.handle | escape }}">
  <a class="pcard__media" href="/products/{{ rec.handle }}" aria-label="{{ rec.title | escape }}">
    <img src="{{ hero | asset_url }}" alt="{{ rec.title | escape }}" loading="lazy" width="800" height="800">
    <div class="pcard__badges"><span class="badge badge--mto">Made to order</span></div>
  </a>
  <div class="pcard__body">
    {%- if rec.collection_title != blank -%}<div class="pcard__coll">{{ rec.collection_title }}</div>{%- endif -%}
    <h3 class="pcard__name"><a href="/products/{{ rec.handle }}">{{ rec.title }}</a></h3>
    <div class="pcard__foot">
      <div class="pcard__price">{{ price_cents | money }}</div>
      <a class="btn btn-primary btn-sm" href="/products/{{ rec.handle }}">View</a>
    </div>
  </div>
</article>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <div class="pagination" style="grid-column:1/-1">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "label": "Products per page", "default": 24 }
  ]
}
{% endschema %}
