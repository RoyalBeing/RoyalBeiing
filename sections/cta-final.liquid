<section class="section cta-final" {{ section.shopify_attributes }}>
  <div class="wrap center reveal">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__cta" style="justify-content:center;margin-top:26px">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn-outline" href="{{ section.settings.button2_link | default: '#collections' }}" style="color:#fff;border-color:#fff">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.closing != blank -%}
      <p class="serif-accent" style="margin-top:28px;font-size:1.4rem;color:var(--rb-gold-500)">{{ section.settings.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Final call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Daily Cleanse Deserves to Feel Extraordinary" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover handmade herbal soaps created to turn an everyday necessity into a beautiful and intentional moment of self-care." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "SHOP ALL SOAPS" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "EXPLORE THE COLLECTIONS" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Royal Being — The Ritual of Being" }
  ],
  "presets": [{ "name": "Final call to action" }]
}
{% endschema %}
