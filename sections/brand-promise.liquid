<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-head center reveal">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="value-grid reveal">
      {%- for block in section.blocks -%}
        <div class="value-card" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h4>{{ block.settings.title }}</h4>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand promise",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Promise to Every Royal Being" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "drop", "label": "Drop" },
          { "value": "heart", "label": "Heart" },
          { "value": "flag", "label": "Flag" },
          { "value": "check", "label": "Check" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Title", "default": "HANDMADE WITH CARE" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every herbal bar is carefully prepared and hand-poured in small batches." }
      ]
    }
  ],
  "presets": [{ "name": "Brand promise" }]
}
{% endschema %}
